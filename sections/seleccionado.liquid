{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    margin: {{ section.settings.margin_top }}px {{ section.settings.margin_x }}px {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% stylesheet %}
  .seleccionado__header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .seleccionado__eyebrow,
  .seleccionado__heading,
  .seleccionado__subtitle {
    margin: 0;
  }

  .seleccionado__eyebrow {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .seleccionado__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    font-weight: 400;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .seleccionado__heading em {
    font-style: italic;
  }

  .seleccionado__subtitle {
    font-size: 1.6rem;
    line-height: 1.5;
    opacity: 0.8;
  }

  .seleccionado__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .seleccionado__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 28px;
  }

  .seleccionado__media {
    aspect-ratio: 8 / 5;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.06);
  }

  .seleccionado__media img,
  .seleccionado__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seleccionado__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 28px 24px 24px;
  }

  .seleccionado__card-label {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .seleccionado__card-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .seleccionado__card-text {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  .seleccionado__list {
    display: flex;
    flex-direction: column;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .seleccionado__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .seleccionado__thumb {
    flex: none;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.6);
  }

  .seleccionado__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seleccionado__name {
    flex: 1;
    min-width: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .seleccionado__price {
    flex: none;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .seleccionado__sold-out {
    flex: none;
    font-size: 1.2rem;
    opacity: 0.7;
  }

  seleccionado-add {
    position: relative;
    flex: none;
  }

  .seleccionado__add {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    background: #fff;
    color: #1c1417;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .seleccionado__add:hover:not(:disabled) {
    background: #f3f3f3;
  }

  .seleccionado__add:active:not(:disabled) {
    transform: scale(0.94);
  }

  .seleccionado__add:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .seleccionado__add[aria-disabled='true'] {
    cursor: progress;
    opacity: 0.6;
  }

  .seleccionado__add .svg-wrapper {
    display: flex;
    width: 14px;
    height: 14px;
  }

  .seleccionado__message {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: 2;
    width: max-content;
    max-width: 220px;
    margin: 0;
    padding: 6px 10px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    font-size: 1.2rem;
    line-height: 1.3;
    color: #b3261e;
  }

  .seleccionado__notice {
    margin: 0;
    padding: 12px 0;
    font-size: 1.2rem;
    opacity: 0.6;
  }

  @media screen and (min-width: 750px) {
    .seleccionado__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .seleccionado__body {
      padding: 32px 32px 28px;
    }
  }
{% endstylesheet %}

{%- liquid
  assign has_header = false
  for block in section.blocks
    if block.type == 'eyebrow' or block.type == 'heading' or block.type == 'subtitle'
      assign has_header = true
      break
    endif
  endfor
-%}

<div class="page-width">
  {%- if has_header -%}
    <div class="seleccionado__header">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="seleccionado__eyebrow" style="color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                {{- block.settings.text | escape -}}
              </p>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.title != blank or block.settings.accent != blank -%}
              <h2 class="seleccionado__heading" style="color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                {{- block.settings.title | escape | newline_to_br -}}
                {%- if block.settings.accent != blank -%}
                  {%- if block.settings.title != blank %} {% endif -%}
                  <em style="color: {{ block.settings.accent_color }};">{{ block.settings.accent | escape }}</em>
                {%- endif -%}
              </h2>
            {%- endif -%}
          {%- when 'subtitle' -%}
            {%- if block.settings.text != blank -%}
              <p class="seleccionado__subtitle" style="color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                {{- block.settings.text | escape -}}
              </p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="seleccionado__grid">
    {%- for card in section.blocks -%}
      {%- if card.type != 'collection' -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign card_index = forloop.index -%}
      <div
        class="seleccionado__card"
        style="background-color: {{ card.settings.card_bg }}; color: {{ card.settings.text_color }};"
        {{ card.shopify_attributes }}
      >
        <div class="seleccionado__media">
          {%- if card.settings.image != blank -%}
            {{
              card.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: card.settings.image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="seleccionado__body">
          {%- if card.settings.label != blank -%}
            <p class="seleccionado__card-label">{{ card.settings.label | escape }}</p>
          {%- endif -%}
          {%- if card.settings.title != blank -%}
            <h3 class="seleccionado__card-title">{{ card.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if card.settings.text != blank -%}
            <p class="seleccionado__card-text">{{ card.settings.text | escape }}</p>
          {%- endif -%}
          <ul class="seleccionado__list">
            {%- assign collecting = false -%}
            {%- for block in section.blocks -%}
              {%- if forloop.index == card_index -%}
                {%- assign collecting = true -%}
                {%- continue -%}
              {%- endif -%}
              {%- if collecting == false -%}
                {%- continue -%}
              {%- endif -%}
              {%- if block.type == 'collection' -%}
                {%- break -%}
              {%- endif -%}
              {%- if block.type != 'product' -%}
                {%- continue -%}
              {%- endif -%}
              {%- liquid
                assign product = block.settings.product
                assign variant = product.selected_or_first_available_variant
              -%}
              {%- if product != blank -%}
                <li class="seleccionado__item" {{ block.shopify_attributes }}>
                  <a href="{{ product.url }}" class="seleccionado__thumb" tabindex="-1" aria-hidden="true">
                    {%- if product.featured_media != blank -%}
                      {{
                        product.featured_media
                        | image_url: width: 120
                        | image_tag: loading: 'lazy', widths: '48, 96, 120', sizes: '48px', alt: ''
                      }}
                    {%- endif -%}
                  </a>
                  <a href="{{ product.url }}" class="seleccionado__name">{{ product.title | escape }}</a>
                  {%- if product.available -%}
                    <span class="seleccionado__price">{{ variant.price | money }}</span>
                    <seleccionado-add data-variant-id="{{ variant.id }}">
                      <button
                        type="button"
                        class="seleccionado__add"
                        aria-label="Agregar {{ product.title | escape }} al carrito"
                      >
                        <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                      </button>
                      <p class="seleccionado__message" role="status" hidden></p>
                    </seleccionado-add>
                  {%- else -%}
                    <span class="seleccionado__sold-out">Agotado</span>
                    <button
                      type="button"
                      class="seleccionado__add"
                      disabled
                      aria-label="{{ product.title | escape }}: agotado"
                    >
                      <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                    </button>
                  {%- endif -%}
                </li>
              {%- elsif request.design_mode -%}
                <li class="seleccionado__notice" {{ block.shopify_attributes }}>
                  Selecciona un producto para este bloque.
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'seleccionado.js' | asset_url }}" defer="defer"></script>

