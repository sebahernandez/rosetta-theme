{%- liquid
  assign heading_font = section.settings.heading_font
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
  assign body_font = section.settings.body_font
  assign hl = section.settings.heading_level | default: 'h2'
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_italic | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
  }
{%- endstyle -%}

{% stylesheet %}
  .contact-rosetta {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cr-gap-m);
    width: 100%;
    max-width: var(--cr-max-width);
    margin-inline: auto;
    padding: var(--cr-pt-m) var(--cr-px-m) var(--cr-pb-m);
    font-family: var(--cr-body-font);
    color: var(--cr-text);
  }

  .contact-rosetta *,
  .contact-rosetta *::before,
  .contact-rosetta *::after {
    box-sizing: border-box;
  }

  .contact-rosetta__intro,
  .contact-rosetta__card {
    min-width: 0;
  }

  .contact-rosetta__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    padding: 8px 14px;
    border-radius: 999px;
    background-color: var(--cr-badge-bg);
    color: var(--cr-badge-text);
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .contact-rosetta__badge-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--cr-badge-dot);
  }

  .contact-rosetta__title {
    margin: 0;
    font-family: var(--cr-heading-font);
    font-weight: var(--cr-heading-weight);
    font-size: var(--cr-title-size-m);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--cr-title);
    overflow-wrap: anywhere;
  }

  .contact-rosetta__title-accent {
    display: block;
    font-style: italic;
    color: var(--cr-accent);
  }

  .contact-rosetta__desc {
    max-width: 42ch;
    margin: 20px 0 0;
    font-size: var(--cr-desc-size-m);
    line-height: 1.5;
    color: var(--cr-text);
    overflow-wrap: anywhere;
  }

  .contact-rosetta__media {
    margin-top: 24px;
    overflow: hidden;
    border-radius: var(--cr-img-radius);
    aspect-ratio: var(--cr-img-ratio);
    background-color: var(--cr-card-border);
  }

  .contact-rosetta__media img,
  .contact-rosetta__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-rosetta__quote {
    margin: 20px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--cr-quote-bar);
  }

  .contact-rosetta__quote-text {
    margin: 0;
    font-family: var(--cr-heading-font);
    font-style: italic;
    font-size: 1.7rem;
    line-height: 1.35;
    color: var(--cr-quote-text);
    overflow-wrap: anywhere;
  }

  .contact-rosetta__quote-author {
    margin: 6px 0 0;
    font-size: 1.3rem;
    color: var(--cr-quote-author);
  }

  .contact-rosetta__card {
    padding: var(--cr-card-pad-y-m) var(--cr-card-pad-x-m);
    border: 1px solid var(--cr-card-border);
    border-radius: var(--cr-card-radius);
    background-color: var(--cr-card-bg);
  }

  .contact-rosetta__form-title {
    margin: 0;
    font-family: var(--cr-heading-font);
    font-weight: var(--cr-heading-weight);
    font-size: var(--cr-form-title-size-m);
    line-height: 1.1;
    color: var(--cr-title);
  }

  .contact-rosetta__note {
    margin: 8px 0 0;
    font-size: 1.4rem;
    color: var(--cr-muted);
  }

  .contact-rosetta__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cr-field-gap);
    margin-top: 24px;
  }

  .contact-rosetta__topics {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact-rosetta__legend {
    display: block;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    font-size: 1.5rem;
    color: var(--cr-title);
  }

  .contact-rosetta__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-rosetta__pill {
    position: relative;
  }

  .contact-rosetta__pill input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .contact-rosetta__pill label {
    display: inline-block;
    padding: 12px 22px;
    border: 1px solid var(--cr-pill-border);
    border-radius: 999px;
    background-color: var(--cr-pill-bg);
    color: var(--cr-pill-text);
    font-size: 1.5rem;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .contact-rosetta__pill input:checked + label {
    border-color: var(--cr-pill-active-bg);
    background-color: var(--cr-pill-active-bg);
    color: var(--cr-pill-active-text);
  }

  .contact-rosetta__pill input:focus-visible + label {
    outline: 2px solid var(--cr-accent);
    outline-offset: 2px;
  }

  .contact-rosetta__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cr-field-gap);
  }

  .contact-rosetta__field {
    min-width: 0;
  }

  .contact-rosetta__input {
    display: block;
    width: 100%;
    min-height: 56px;
    padding: 16px 22px;
    border: 1px solid var(--cr-input-border);
    border-radius: var(--cr-input-radius);
    background-color: var(--cr-input-bg);
    color: var(--cr-input-text);
    font-family: inherit;
    font-size: var(--cr-input-size);
    line-height: 1.3;
  }

  .contact-rosetta__input::placeholder {
    color: var(--cr-placeholder);
    opacity: 1;
  }

  textarea.contact-rosetta__input {
    min-height: 140px;
    resize: vertical;
  }

  .contact-rosetta__input:focus-visible {
    outline: 2px solid var(--cr-accent);
    outline-offset: 2px;
  }

  .contact-rosetta__footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .contact-rosetta__footer-note {
    margin: 0;
    font-size: 1.4rem;
    color: var(--cr-muted);
  }

  .contact-rosetta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: 999px;
    background-color: var(--cr-btn-bg);
    color: var(--cr-btn-text);
    font-family: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .contact-rosetta__button:hover {
    background-color: var(--cr-btn-hover);
  }

  .contact-rosetta__button:focus-visible {
    outline: 2px solid var(--cr-title);
    outline-offset: 2px;
  }

  .contact-rosetta__button svg {
    display: block;
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-rosetta__message {
    margin: 20px 0 0;
    padding: 12px 16px;
    border-radius: 12px;
    background-color: var(--cr-input-bg);
    border: 1px solid var(--cr-input-border);
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--cr-title);
  }

  .contact-rosetta__message ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }

  @media screen and (min-width: 750px) {
    .contact-rosetta {
      gap: var(--cr-gap-d);
      padding: var(--cr-pt-d) var(--cr-px-d) var(--cr-pb-d);
    }

    .contact-rosetta__title {
      font-size: var(--cr-title-size-d);
    }

    .contact-rosetta__desc {
      font-size: var(--cr-desc-size-d);
    }

    .contact-rosetta__card {
      padding: var(--cr-card-pad-y-d) var(--cr-card-pad-x-d);
    }

    .contact-rosetta__form-title {
      font-size: var(--cr-form-title-size-d);
    }

    .contact-rosetta__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-rosetta__footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .contact-rosetta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
{% endstylesheet %}

<div
  class="contact-rosetta"
  style="
    --cr-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --cr-heading-weight: {{ heading_font.weight }};
    --cr-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --cr-max-width: {{ section.settings.max_width }}px;
    --cr-gap-m: {{ section.settings.gap_mobile }}px;
    --cr-gap-d: {{ section.settings.gap_desktop }}px;
    --cr-pt-m: {{ section.settings.padding_top_mobile }}px;
    --cr-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --cr-px-m: {{ section.settings.padding_x_mobile }}px;
    --cr-pt-d: {{ section.settings.padding_top_desktop }}px;
    --cr-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --cr-px-d: {{ section.settings.padding_x_desktop }}px;
    --cr-card-pad-y-m: {{ section.settings.card_padding_y_mobile }}px;
    --cr-card-pad-x-m: {{ section.settings.card_padding_x_mobile }}px;
    --cr-card-pad-y-d: {{ section.settings.card_padding_y_desktop }}px;
    --cr-card-pad-x-d: {{ section.settings.card_padding_x_desktop }}px;
    --cr-field-gap: {{ section.settings.field_gap }}px;
    --cr-title-size-m: {{ section.settings.title_size_mobile | divided_by: 10.0 }}rem;
    --cr-title-size-d: {{ section.settings.title_size_desktop | divided_by: 10.0 }}rem;
    --cr-desc-size-m: {{ section.settings.desc_size_mobile | divided_by: 10.0 }}rem;
    --cr-desc-size-d: {{ section.settings.desc_size_desktop | divided_by: 10.0 }}rem;
    --cr-form-title-size-m: {{ section.settings.form_title_size_mobile | divided_by: 10.0 }}rem;
    --cr-form-title-size-d: {{ section.settings.form_title_size_desktop | divided_by: 10.0 }}rem;
    --cr-input-size: {{ section.settings.input_size | divided_by: 10.0 }}rem;
    --cr-card-radius: {{ section.settings.card_radius }}px;
    --cr-input-radius: {{ section.settings.input_radius }}px;
    --cr-img-radius: {{ section.settings.image_radius }}px;
    --cr-img-ratio: {{ section.settings.image_ratio }};
    --cr-badge-bg: {{ section.settings.badge_bg }};
    --cr-badge-text: {{ section.settings.badge_text_color }};
    --cr-badge-dot: {{ section.settings.badge_dot_color }};
    --cr-title: {{ section.settings.title_color }};
    --cr-accent: {{ section.settings.accent_color }};
    --cr-text: {{ section.settings.text_color }};
    --cr-muted: {{ section.settings.muted_color }};
    --cr-quote-text: {{ section.settings.quote_color }};
    --cr-quote-author: {{ section.settings.quote_author_color }};
    --cr-quote-bar: {{ section.settings.quote_bar_color }};
    --cr-card-bg: {{ section.settings.card_bg }};
    --cr-card-border: {{ section.settings.card_border }};
    --cr-input-bg: {{ section.settings.input_bg }};
    --cr-input-border: {{ section.settings.input_border }};
    --cr-input-text: {{ section.settings.input_text }};
    --cr-placeholder: {{ section.settings.placeholder_color }};
    --cr-pill-bg: {{ section.settings.pill_bg }};
    --cr-pill-border: {{ section.settings.pill_border }};
    --cr-pill-text: {{ section.settings.pill_text }};
    --cr-pill-active-bg: {{ section.settings.pill_active_bg }};
    --cr-pill-active-text: {{ section.settings.pill_active_text }};
    --cr-btn-bg: {{ section.settings.button_bg }};
    --cr-btn-text: {{ section.settings.button_text_color }};
    --cr-btn-hover: {{ section.settings.button_hover_bg }};
  "
>
  <div class="contact-rosetta__intro">
    {%- if section.settings.badge_text != blank -%}
      <p class="contact-rosetta__badge">
        <span class="contact-rosetta__badge-dot" aria-hidden="true"></span>
        {{ section.settings.badge_text | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <{{ hl }} class="contact-rosetta__title">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank -%}
          <span class="contact-rosetta__title-accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </{{ hl }}>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="contact-rosetta__desc">{{ section.settings.description | escape }}</p>
    {%- endif -%}

    <div class="contact-rosetta__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image_alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    {%- if section.settings.quote != blank -%}
      <blockquote class="contact-rosetta__quote">
        <p class="contact-rosetta__quote-text">{{ section.settings.quote | escape }}</p>
        {%- if section.settings.quote_author != blank -%}
          <p class="contact-rosetta__quote-author">{{ section.settings.quote_author | escape }}</p>
        {%- endif -%}
      </blockquote>
    {%- endif -%}
  </div>

  <div class="contact-rosetta__card">
    {%- if section.settings.form_title != blank -%}
      <h3 class="contact-rosetta__form-title">{{ section.settings.form_title | escape }}</h3>
    {%- endif -%}
    {%- if section.settings.required_note != blank -%}
      <p class="contact-rosetta__note">{{ section.settings.required_note | escape }}</p>
    {%- endif -%}

    {%- form 'contact', id: 'ContactRosetta', class: 'contact-rosetta__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact-rosetta__message" role="status" tabindex="-1" autofocus>
          {{- section.settings.success_text | escape -}}
        </p>
      {%- elsif form.errors -%}
        <div class="contact-rosetta__message" role="alert" tabindex="-1" autofocus>
          <ul role="list">
            <li>
              <a href="#ContactRosetta-email-{{ section.id }}">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </a>
            </li>
          </ul>
        </div>
      {%- endif -%}

      <div class="contact-rosetta__fields">
        {%- if section.blocks.size > 0 -%}
          {%- assign selected_topic = form['Motivo'] -%}
          <fieldset class="contact-rosetta__topics">
            {%- if section.settings.topic_label != blank -%}
              <legend class="contact-rosetta__legend">{{ section.settings.topic_label | escape }}</legend>
            {%- endif -%}
            <div class="contact-rosetta__pills">
              {%- for block in section.blocks -%}
                {%- assign topic = block.settings.label | strip -%}
                <div class="contact-rosetta__pill" {{ block.shopify_attributes }}>
                  <input
                    type="radio"
                    id="ContactRosetta-topic-{{ block.id }}"
                    name="contact[Motivo]"
                    value="{{ topic | escape }}"
                    {% if selected_topic == topic or selected_topic == blank and forloop.first %}
                      checked
                    {% endif %}
                  >
                  <label for="ContactRosetta-topic-{{ block.id }}">{{ topic | escape }}</label>
                </div>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        <div class="contact-rosetta__row">
          <div class="contact-rosetta__field">
            <input
              id="ContactRosetta-name-{{ section.id }}"
              class="contact-rosetta__input"
              type="text"
              name="contact[Nombre]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ section.settings.name_label | escape }}"
              aria-label="{{ section.settings.name_label | escape }}"
              autocomplete="name"
              required
            >
          </div>
          <div class="contact-rosetta__field">
            <input
              id="ContactRosetta-email-{{ section.id }}"
              class="contact-rosetta__input"
              type="email"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="{{ section.settings.email_label | escape }}"
              aria-label="{{ section.settings.email_label | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}
            >
          </div>
        </div>

        <div class="contact-rosetta__field">
          <input
            id="ContactRosetta-phone-{{ section.id }}"
            class="contact-rosetta__input"
            type="tel"
            name="contact[Teléfono]"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ section.settings.phone_label | escape }}"
            aria-label="{{ section.settings.phone_label | escape }}"
            autocomplete="tel"
          >
        </div>

        <div class="contact-rosetta__field">
          <textarea
            id="ContactRosetta-body-{{ section.id }}"
            class="contact-rosetta__input"
            name="contact[body]"
            rows="6"
            placeholder="{{ section.settings.message_label | escape }}"
            aria-label="{{ section.settings.message_label | escape }}"
            required
          >
            {{- form.body -}}
          </textarea>
        </div>

        <div class="contact-rosetta__footer">
          {%- if section.settings.footer_note != blank -%}
            <p class="contact-rosetta__footer-note">{{ section.settings.footer_note | escape }}</p>
          {%- endif -%}
          <button type="submit" class="contact-rosetta__button">
            <span>{{ section.settings.button_label | escape }}</span>
            {%- if section.settings.show_arrow -%}
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M2 8h12M9 3l5 5-5 5"></path>
              </svg>
            {%- endif -%}
          </button>
        </div>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contacto Rosetta",
  "tag": "section",
  "class": "contact-rosetta-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Insignia" },
    { "type": "text", "id": "badge_text", "label": "Texto de la insignia", "default": "Atención 24/7" },

    { "type": "header", "content": "Título y descripción" },
    { "type": "text", "id": "heading", "label": "Título (línea 1)", "default": "Hablemos," },
    { "type": "text", "id": "heading_accent", "label": "Título (línea 2, con acento)", "default": "estamos cerca." },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Nivel del encabezado",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "¿Una duda con tu pedido, un pago o un producto? Escríbenos y una persona de nuestro equipo te responde."
    },

    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo de la imagen" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "16 / 9", "label": "16:9" }
      ],
      "default": "3 / 2"
    },
    { "type": "range", "id": "image_radius", "label": "Radio de la imagen", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 28 },

    { "type": "header", "content": "Cita" },
    { "type": "text", "id": "quote", "label": "Cita", "default": "“Cada mensaje lo responde alguien de la casa.”" },
    { "type": "text", "id": "quote_author", "label": "Autor de la cita", "default": "Equipo Rosetta · Tucacas, estado Falcón" },

    { "type": "header", "content": "Formulario: textos" },
    { "type": "text", "id": "form_title", "label": "Título del formulario", "default": "Escríbenos" },
    { "type": "text", "id": "required_note", "label": "Nota de campos obligatorios", "default": "Los campos con * son obligatorios." },
    { "type": "text", "id": "topic_label", "label": "Pregunta del selector de motivo", "default": "¿Sobre qué nos escribes?" },
    { "type": "text", "id": "name_label", "label": "Campo nombre", "default": "Nombre *" },
    { "type": "text", "id": "email_label", "label": "Campo correo", "default": "Correo electrónico *" },
    { "type": "text", "id": "phone_label", "label": "Campo teléfono", "default": "Teléfono (opcional)" },
    { "type": "text", "id": "message_label", "label": "Campo mensaje", "default": "Tu mensaje *" },
    { "type": "text", "id": "footer_note", "label": "Nota al pie", "default": "Respondemos en horario de atención." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Enviar mensaje" },
    { "type": "checkbox", "id": "show_arrow", "label": "Mostrar flecha en el botón", "default": true },
