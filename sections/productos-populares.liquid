      "id": "margin_top",
      "label": "Margen superior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_x",
      "label": "Margen lateral",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Relleno del contenedor"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Relleno lateral",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Etiqueta superior",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Productos populares"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#8a1f7a"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
