          "label": "Título",
          "info": "Usa un salto de línea para dividirlo en dos líneas.",
          "default": "Lo que más se llevan esta semana."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#1c1417"
        }
      ]
    },
    {
      "type": "filter",
      "name": "Filtro",
      "settings": [
        {
          "type": "text",
