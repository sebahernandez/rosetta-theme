            "min": 0.8,
            "max": 1.3,
            "step": 0.1,
            "default": 0.9,
            "label": "Tamaño del botón",
            "unit": "rem",
            "info": "Personaliza el tamaño de fuente para el texto del botón"
          }, {
            "type": "header",
            "content": "Overlay personalizado"
          }, {
            "type": "checkbox",
            "id": "use_custom_overlay",
            "label": "Usar overlay personalizado",
            "default": false,
            "info": "Activa para personalizar el overlay de esta tarjeta"
          }, {
            "type": "color",
            "id": "overlay_color",
            "label": "Color del overlay",
            "default": "#000000"
          }, {
            "type": "range",
            "id": "overlay_opacity",
            "min": 0.1,
            "max": 0.9,
            "step": 0.1,
            "default": 0.4,
            "label": "Opacidad del overlay",
            "info": "Personaliza la transparencia del overlay para esta tarjeta"
          }, {
            "type": "header",
            "content": "Colores personalizados"
          }, {
            "type": "checkbox",
            "id": "use_custom_colors",
            "label": "Usar colores personalizados",
            "default": false,
            "info": "Activa para personalizar los colores de esta tarjeta"
          }, {
            "type": "color",
            "id": "custom_subheading_color",
            "label": "Color del subtítulo",
            "default": "#555555"
          }, {
            "type": "color",
            "id": "custom_title_color",
            "label": "Color del título",
            "default": "#111111"
          }, {
            "type": "color",
            "id": "custom_price_color",
            "label": "Color del precio",
            "default": "#444444"
          }, {
            "type": "color",
            "id": "custom_button_text_color",
            "label": "Color del texto del botón",
            "default": "#ffffff"
          }, {
            "type": "color",
            "id": "custom_button_background_color",
            "label": "Color de fondo del botón",
            "default": "#ff49b3"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Tarjetas Promocionales",
        "category": "Secciones personalizadas",
        "blocks": [
          {
            "type": "promo",
            "settings": {
              "subheading": "100% fresca",
