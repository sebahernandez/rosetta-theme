            "step": 0.1,
            "default": 1.3,
            "label": "Tamaño del título",
            "unit": "rem",
            "info": "Personaliza el tamaño de fuente para el título principal"
          }, {
            "type": "range",
            "id": "custom_price_size",
            "min": 0.8,
            "max": 1.5,
            "step": 0.1,
            "default": 1.0,
            "label": "Tamaño del precio",
            "unit": "rem",
            "info": "Personaliza el tamaño de fuente para el texto de precio"
          }, {
