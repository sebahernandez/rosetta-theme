{%- liquid
  assign img = section.settings.image
-%}

<div
  class="supermercado-linea page-width"
  style="
    --sl-margin-top: {{ section.settings.margin_top }}px;
    --sl-margin-bottom: {{ section.settings.margin_bottom }}px;
    --sl-padding-top: {{ section.settings.padding_top }}px;
    --sl-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div
    class="supermercado-linea__wrapper"
    style="
      --sl-panel-bg: {{ section.settings.panel_bg }};
      --sl-text: {{ section.settings.text_color }};
      --sl-accent: {{ section.settings.accent_color }};
      --sl-btn-bg: {{ section.settings.button_bg }};
      --sl-btn-text: {{ section.settings.button_text }};
      --sl-highlight: {{ section.settings.highlight_bg }};
      --sl-radius: {{ section.settings.radius }}px;
    ">
    <div class="supermercado-linea__panel">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <p class="supermercado-linea__badge" {{ block.shopify_attributes }}>
            <span class="supermercado-linea__badge-dot" aria-hidden="true"></span>
            {{- block.settings.text -}}
          </p>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          <h2 class="supermercado-linea__heading" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
            {%- if block.settings.accent != blank -%}
              <em class="supermercado-linea__accent">{{ block.settings.accent }}</em>
            {%- endif -%}
          </h2>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'description' -%}
          <div class="supermercado-linea__description" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- assign has_buttons = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' -%}
          {%- assign has_buttons = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_buttons -%}
        <div class="supermercado-linea__buttons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' and block.settings.label != blank -%}
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="supermercado-linea__button supermercado-linea__button--{{ block.settings.style }}"
                {{ block.shopify_attributes }}>
                {{- block.settings.label -}}
                {%- if block.settings.show_arrow -%}
                  <svg class="supermercado-linea__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign has_features = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          {%- assign has_features = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_features -%}
        <ul class="supermercado-linea__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="supermercado-linea__feature" {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                  {%- when 'shield' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'clock' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                  {%- when 'tag' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.2"/></svg>
                {%- endcase -%}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="supermercado-linea__media">
      {%- if img != blank -%}
        {{
          img
          | image_url: width: 1400
          | image_tag:
            class: 'supermercado-linea__image',
            sizes: '(min-width: 990px) 50vw, 100vw',
            widths: '600, 900, 1200, 1400',
            loading: 'lazy'
        }}
      {%- else -%}
        <div class="supermercado-linea__placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'promo' -%}
          <div class="supermercado-linea__promo" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <span class="supermercado-linea__promo-label">{{ block.settings.label }}</span>
            {%- endif -%}
            <p class="supermercado-linea__promo-title">
              {{- block.settings.prefix }}
              {% if block.settings.highlight != blank -%}
                <span class="supermercado-linea__promo-highlight">{{ block.settings.highlight }}</span>
              {%- endif %}
              {{ block.settings.suffix -}}
            </p>
            {%- if block.settings.caption != blank -%}
              <span class="supermercado-linea__promo-caption">{{ block.settings.caption }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .supermercado-linea {
    margin-top: var(--sl-margin-top);
    margin-bottom: var(--sl-margin-bottom);
    margin-left: auto;
    margin-right: auto;
    padding-top: var(--sl-padding-top);
    padding-bottom: var(--sl-padding-bottom);
  }

  .supermercado-linea__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-radius: var(--sl-radius);
    background-color: var(--sl-panel-bg);
    color: var(--sl-text);
  }

  .supermercado-linea__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2.4rem;
    padding: 5rem 4rem;
    min-width: 0;
  }

  .supermercado-linea__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0.7rem 1.4rem;
    border-radius: 99rem;
    background: #fff;
    color: #1a1a1a;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .supermercado-linea__badge-dot {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--sl-btn-bg);
  }

  .supermercado-linea__heading {
    margin: 0;
    font-size: clamp(3.6rem, 5vw, 6.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--sl-text);
    overflow-wrap: break-word;
  }

  .supermercado-linea__accent {
    display: block;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    color: var(--sl-accent);
  }

  .supermercado-linea__description {
    max-width: 44rem;
    font-size: 1.7rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  .supermercado-linea__description p {
    margin: 0;
  }

  .supermercado-linea__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .supermercado-linea__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 5.2rem;
    padding: 0 2.4rem;
    border-radius: 99rem;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .supermercado-linea__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 0.6rem 1.6rem rgba(0, 0, 0, 0.12);
  }

  .supermercado-linea__button--primary {
    background: var(--sl-btn-bg);
    color: var(--sl-btn-text);
  }

  .supermercado-linea__button--secondary {
    background: #fff;
    color: #1a1a1a;
    border: 0.1rem solid rgba(0, 0, 0, 0.15);
  }

  .supermercado-linea__features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
    width: 100%;
    margin: 0;
    padding: 2.4rem 0 0;
    list-style: none;
    border-top: 0.1rem solid rgba(0, 0, 0, 0.15);
  }

  .supermercado-linea__feature {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    opacity: 0.85;
  }

  .supermercado-linea__media {
    position: relative;
    min-height: 100%;
    background: rgba(0, 0, 0, 0.04);
  }

  .supermercado-linea__image,
  .supermercado-linea__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .supermercado-linea__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .supermercado-linea__promo {
    position: absolute;
    left: 3.2rem;
    bottom: 3.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: calc(100% - 6.4rem);
    padding: 1.6rem 2rem;
    border-radius: 1.6rem;
    background: rgba(255, 255, 255, 0.95);
    color: #1a1a1a;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.12);
  }

  .supermercado-linea__promo-label {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .supermercado-linea__promo-title {
    margin: 0;
    font-size: 2.4rem;
    line-height: 1.2;
  }

  .supermercado-linea__promo-highlight {
    padding: 0 0.6rem;
    border-radius: 0.6rem;
    background: var(--sl-highlight);
  }

  .supermercado-linea__promo-caption {
    font-size: 1.2rem;
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .supermercado-linea__wrapper {
      grid-template-columns: 1fr;
    }

    .supermercado-linea__panel {
      gap: 2rem;
      padding: 3.2rem 2rem;
    }

    .supermercado-linea__media {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .supermercado-linea__promo {
      left: 1.6rem;
      bottom: 1.6rem;
      max-width: calc(100% - 3.2rem);
      padding: 1.2rem 1.6rem;
    }

    .supermercado-linea__promo-title {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .supermercado-linea__buttons {
      width: 100%;
    }

    .supermercado-linea__button {
      flex: 1 1 auto;
    }

    .supermercado-linea__features {
      gap: 1rem 1.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Supermercado en línea",
  "tag": "section",
  "class": "section-supermercado-linea",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "header",
      "content": "Espaciado del contenedor"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Colores y forma"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Fondo del panel",
      "default": "#ffd9f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#1f1a1d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color del texto destacado",
      "default": "#9b1b86"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fondo del botón principal",
      "default": "#ff6fd8"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Texto del botón principal",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Fondo del porcentaje destacado",
      "default": "#7dffd0"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radio de las esquinas",
      "unit": "px",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Etiqueta",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Supermercado en línea · Venezuela"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Lo de todos los días,"
        },
        {
          "type": "text",
          "id": "accent",
          "label": "Texto destacado (cursiva)",
          "default": "mejor elegido."
        }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Panadería, carnes, despensa, bebidas y cuidado personal en un solo carrito. Precios claros en dólares y bolívares.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Botón",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto del botón",
          "default": "Empezar a comprar"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Estilo",
          "options": [
            { "value": "primary", "label": "Principal" },
            { "value": "secondary", "label": "Secundario" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Mostrar flecha",
          "default": true
        }
      ]
    },
    {
      "type": "feature",
      "name": "Beneficio",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Seguridad" },
            { "value": "clock", "label": "Reloj" },
            { "value": "tag", "label": "Etiqueta" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratuito"
        }
      ]
    },
    {
      "type": "promo",
      "name": "Tarjeta promocional",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta superior",
          "default": "Club del ahorro"
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Texto antes del destacado",
          "default": "Hasta"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Texto destacado",
          "default": "20%"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Texto después del destacado",
          "default": "menos"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Texto inferior",
          "default": "En productos seleccionados"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Supermercado en línea",
      "blocks": [
        { "type": "badge" },
        { "type": "heading" },
        { "type": "description" },
        { "type": "button" },
        {
          "type": "button",
          "settings": {
            "label": "Ver ofertas",
            "style": "secondary",
            "show_arrow": false
          }
        },
        { "type": "feature" },
        {
          "type": "feature",
          "settings": { "icon": "shield", "text": "Pago seguro" }
        },
        {
          "type": "feature",
          "settings": { "icon": "clock", "text": "Atención 24/7" }
        },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}
