{%- liquid
  assign has_methods = false
  for block in section.blocks
    if block.type == 'metodo' and block.settings.title != blank
      assign has_methods = true
    endif
  endfor
-%}

{%- if section.settings.section_bg != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
  {%- endstyle -%}
{%- endif -%}

{% stylesheet %}
  .cp {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--cp-max-width);
    margin-inline: auto;
    padding: var(--cp-pt-m) var(--cp-px-m) var(--cp-pb-m);
  }

  .cp *,
  .cp *::before,
  .cp *::after {
    box-sizing: border-box;
  }

  .cp__item {
    min-width: 0;
    margin-bottom: var(--cp-mb, 0px);
  }

  .cp__label {
    margin: 0;
    font-family: var(--cp-font);
    font-weight: var(--cp-weight);
    font-size: var(--cp-size-m);
    line-height: 1.4;
    letter-spacing: var(--cp-tracking);
    text-transform: uppercase;
    color: var(--cp-color);
    overflow-wrap: anywhere;
  }

  .cp__title {
    margin: 0;
    font-family: var(--cp-font);
    font-weight: var(--cp-weight);
    font-size: var(--cp-size-m);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--cp-color);
    overflow-wrap: anywhere;
  }

  .cp__title-accent {
    font-style: italic;
    color: var(--cp-accent);
  }

  .cp__text {
    max-width: var(--cp-measure);
    margin: 0;
    font-family: var(--cp-font);
    font-weight: var(--cp-weight);
    font-size: var(--cp-size-m);
    line-height: 1.55;
    color: var(--cp-color);
    overflow-wrap: anywhere;
  }

  .cp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cp-gap);
  }

  .cp__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--cp-card-py) var(--cp-card-px);
    border: 1px solid var(--cp-card-border);
    border-radius: var(--cp-card-radius);
    background-color: var(--cp-card-bg);
    font-family: var(--cp-font);
    font-weight: var(--cp-weight);
  }

  .cp__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: var(--cp-head-gap);
  }

  .cp__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--cp-icon-size);
    height: var(--cp-icon-size);
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--cp-icon-bg);
    color: var(--cp-icon-color);
  }

  .cp__icon svg {
    display: block;
    width: 45%;
    height: 45%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cp__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cp__badge {
    max-width: 60%;
    margin: 0;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: var(--cp-badge-bg);
    color: var(--cp-badge-color);
    font-size: 1.1rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .cp__card-title,
  .cp__card-text {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .cp__card-title {
    font-size: var(--cp-ctitle-m);
    line-height: 1.25;
    color: var(--cp-ctitle-color);
  }

  .cp__card-text {
    margin-top: 12px;
    font-size: var(--cp-ctext-m);
    line-height: 1.55;
    color: var(--cp-ctext-color);
  }

  .cp__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 20px 0 0;
    border-top: 2px solid var(--cp-divider);
    list-style: none;
  }

  .cp__card-body {
    margin-bottom: 24px;
  }

  .cp__chip {
    margin: 0;
    padding: 4px 12px;
    border: 1px solid var(--cp-chip-border);
    border-radius: 999px;
    background-color: var(--cp-chip-bg);
    color: var(--cp-chip-color);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .cp {
      padding: var(--cp-pt-d) var(--cp-px-d) var(--cp-pb-d);
    }

    .cp__label,
    .cp__text,
    .cp__title {
      font-size: var(--cp-size-d);
    }

    .cp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cp__card-title {
      font-size: var(--cp-ctitle-d);
    }

    .cp__card-text {
      font-size: var(--cp-ctext-d);
    }
  }

  @media screen and (min-width: 990px) {
    .cp__grid {
      grid-template-columns: repeat(var(--cp-cols), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

<div
  class="cp"
  style="
    --cp-max-width: {{ section.settings.max_width }}px;
    --cp-cols: {{ section.settings.columns }};
    --cp-gap: {{ section.settings.gap }}px;
    --cp-pt-m: {{ section.settings.padding_top_mobile }}px;
    --cp-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --cp-px-m: {{ section.settings.padding_x_mobile }}px;
    --cp-pt-d: {{ section.settings.padding_top_desktop }}px;
    --cp-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --cp-px-d: {{ section.settings.padding_x_desktop }}px;
  "
>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'etiqueta' -%}
        {%- if block.settings.text != blank -%}
          {%- assign e_font = block.settings.font -%}
          {%- style -%}
            {{ e_font | font_face: font_display: 'swap' }}
          {%- endstyle -%}
          <div
            class="cp__item cp__item--etiqueta"
            style="
              --cp-mb: {{ block.settings.margin_bottom }}px;
              --cp-font: {{ e_font.family }}, {{ e_font.fallback_families }};
              --cp-weight: {{ e_font.weight }};
              --cp-size-m: {{ block.settings.size_mobile | divided_by: 10.0 }}rem;
              --cp-size-d: {{ block.settings.size_desktop | divided_by: 10.0 }}rem;
              --cp-tracking: {{ block.settings.letter_spacing | divided_by: 100.0 }}em;
              --cp-color: {{ block.settings.color }};
            "
            {{ block.shopify_attributes }}
          >
            <p class="cp__label">{{ block.settings.text | escape }}</p>
          </div>
        {%- endif -%}

      {%- when 'titulo' -%}
        {%- if block.settings.text != blank or block.settings.accent != blank -%}
          {%- assign t_font = block.settings.font -%}
          {%- assign t_font_italic = t_font | font_modify: 'style', 'italic' -%}
          {%- style -%}
            {{ t_font | font_face: font_display: 'swap' }}
            {{ t_font_italic | font_face: font_display: 'swap' }}
          {%- endstyle -%}
          <div
            class="cp__item cp__item--titulo"
            style="
              --cp-mb: {{ block.settings.margin_bottom }}px;
              --cp-font: {{ t_font.family }}, {{ t_font.fallback_families }};
              --cp-weight: {{ t_font.weight }};
              --cp-size-m: {{ block.settings.size_mobile | divided_by: 10.0 }}rem;
              --cp-size-d: {{ block.settings.size_desktop | divided_by: 10.0 }}rem;
              --cp-color: {{ block.settings.color }};
              --cp-accent: {{ block.settings.accent_color }};
            "
            {{ block.shopify_attributes }}
          >
            <{{ block.settings.heading_level }} class="cp__title">
              {{- block.settings.text | escape -}}
              {%- if block.settings.accent != blank %} <span class="cp__title-accent">{{ block.settings.accent | escape }}</span>{% endif -%}
            </{{ block.settings.heading_level }}>
          </div>
        {%- endif -%}

      {%- when 'subtitulo' -%}
        {%- if block.settings.text != blank -%}
          {%- assign x_font = block.settings.font -%}
          {%- style -%}
            {{ x_font | font_face: font_display: 'swap' }}
          {%- endstyle -%}
          <div
            class="cp__item cp__item--subtitulo"
            style="
              --cp-mb: {{ block.settings.margin_bottom }}px;
              --cp-font: {{ x_font.family }}, {{ x_font.fallback_families }};
              --cp-weight: {{ x_font.weight }};
              --cp-size-m: {{ block.settings.size_mobile | divided_by: 10.0 }}rem;
              --cp-size-d: {{ block.settings.size_desktop | divided_by: 10.0 }}rem;
              --cp-color: {{ block.settings.color }};
              --cp-measure: {{ block.settings.max_width }}ch;
            "
            {{ block.shopify_attributes }}
          >
            <p class="cp__text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}

  {%- if has_methods -%}
    <div class="cp__grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'metodo' or block.settings.title == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign m_font = block.settings.font -%}
        {%- style -%}
          {{ m_font | font_face: font_display: 'swap' }}
        {%- endstyle -%}
        <article
          class="cp__card"
          style="
            --cp-font: {{ m_font.family }}, {{ m_font.fallback_families }};
            --cp-weight: {{ m_font.weight }};
            --cp-card-bg: {{ block.settings.card_bg_color }};
            --cp-card-border: {{ block.settings.card_border_color }};
            --cp-card-radius: {{ block.settings.radius }}px;
            --cp-card-py: {{ block.settings.padding_y }}px;
            --cp-card-px: {{ block.settings.padding_x }}px;
            --cp-head-gap: {{ block.settings.head_gap }}px;
            --cp-icon-size: {{ block.settings.icon_size }}px;
            --cp-icon-bg: {{ block.settings.icon_bg_color }};
            --cp-icon-color: {{ block.settings.icon_color }};
            --cp-badge-bg: {{ block.settings.badge_bg_color }};
            --cp-badge-color: {{ block.settings.badge_color }};
            --cp-ctitle-m: {{ block.settings.title_size_mobile | divided_by: 10.0 }}rem;
            --cp-ctitle-d: {{ block.settings.title_size_desktop | divided_by: 10.0 }}rem;
            --cp-ctext-m: {{ block.settings.text_size_mobile | divided_by: 10.0 }}rem;
            --cp-ctext-d: {{ block.settings.text_size_desktop | divided_by: 10.0 }}rem;
            --cp-ctitle-color: {{ block.settings.title_color }};
            --cp-ctext-color: {{ block.settings.text_color }};
            --cp-divider: {{ block.settings.divider_color }};
            --cp-chip-bg: {{ block.settings.chip_bg_color }};
            --cp-chip-border: {{ block.settings.chip_border_color }};
            --cp-chip-color: {{ block.settings.chip_color }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="cp__card-head">
            {%- if block.settings.icon_image != blank or block.settings.icon != 'none' -%}
              <span class="cp__icon" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" focusable="false">
                    {%- case block.settings.icon -%}
                      {%- when 'transfer' -%}
                        <path d="M4 8h14M14 4l4 4-4 4"></path>
                        <path d="M20 16H6M10 12l-4 4 4 4"></path>
                      {%- when 'card' -%}
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <path d="M3 10h18"></path>
                      {%- when 'cash' -%}
                        <rect x="3" y="6" width="18" height="12" rx="2"></rect>
                        <circle cx="12" cy="12" r="2.5"></circle>
                      {%- when 'phone' -%}
                        <rect x="7" y="3" width="10" height="18" rx="2"></rect>
                        <path d="M11 18h2"></path>
                      {%- when 'wallet' -%}
                        <path d="M4 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4z"></path>
                        <path d="M4 7l12-3v3"></path>
                        <path d="M16 13.5h2"></path>
                      {%- when 'shield' -%}
                        <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path>
                        <path d="M9 12l2 2 4-4"></path>
                    {%- endcase -%}
                  </svg>
                {%- endif -%}
              </span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <p class="cp__badge">{{ block.settings.badge | escape }}</p>
            {%- endif -%}
          </div>

          <div class="cp__card-body">
            <h3 class="cp__card-title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="cp__card-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>

          {%- if block.settings.chips != blank -%}
            {%- assign chips = block.settings.chips | split: ',' -%}
            <ul class="cp__chips">
              {%- for chip in chips -%}
                {%- assign chip_text = chip | strip -%}
                {%- if chip_text != blank -%}
                  <li class="cp__chip">{{ chip_text | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cómo Pagar",
  "tag": "section",
  "class": "como-pagar-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Fondo y contenedor" },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Fondo de la sección",
      "info": "Sin color, el fondo es transparente."
    },
    { "type": "range", "id": "max_width", "label": "Ancho máximo del contenido", "unit": "px", "min": 800, "max": 1800, "step": 20, "default": 1280 },

    { "type": "header", "content": "Tarjetas" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "range", "id": "gap", "label": "Espacio entre tarjetas", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 16 },

    { "type": "header", "content": "Espaciados: escritorio" },
    { "type": "range", "id": "padding_top_desktop", "label": "Relleno superior", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Relleno inferior", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_x_desktop", "label": "Relleno lateral", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 24 },

    { "type": "header", "content": "Espaciados: móvil" },
    { "type": "range", "id": "padding_top_mobile", "label": "Relleno superior", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Relleno inferior", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_x_mobile", "label": "Relleno lateral", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 16 }
  ],
  "blocks": [
    {
      "type": "etiqueta",
      "name": "Etiqueta",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "¿Cómo pagar en Rosetta?" },
        { "type": "font_picker", "id": "font", "label": "Fuente", "default": "poppins_n4" },
        { "type": "range", "id": "size_mobile", "label": "Tamaño en móvil", "unit": "px", "min": 9, "max": 18, "step": 1, "default": 11 },
        { "type": "range", "id": "size_desktop", "label": "Tamaño en escritorio", "unit": "px", "min": 9, "max": 20, "step": 1, "default": 12 },
        { "type": "range", "id": "letter_spacing", "label": "Espaciado entre letras", "unit": "%", "min": 0, "max": 30, "step": 2, "default": 12 },
        { "type": "color", "id": "color", "label": "Color del texto", "default": "#a3157c" },
        { "type": "range", "id": "margin_bottom", "label": "Espacio inferior", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 8 }
      ]
    },
    {
      "type": "titulo",
      "name": "Título",
      "settings": [
        { "type": "text", "id": "text", "label": "Título", "default": "Paga como te quede mejor." },
        { "type": "text", "id": "accent", "label": "Texto de acento (cursiva)" },
        {
          "type": "select",
          "id": "heading_level",
          "label": "Nivel del encabezado",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2"
        },
        { "type": "font_picker", "id": "font", "label": "Fuente", "default": "poppins_n4" },
        { "type": "range", "id": "size_mobile", "label": "Tamaño en móvil", "unit": "px", "min": 24, "max": 64, "step": 2, "default": 30 },
        { "type": "range", "id": "size_desktop", "label": "Tamaño en escritorio", "unit": "px", "min": 28, "max": 96, "step": 2, "default": 40 },
        { "type": "color", "id": "color", "label": "Color del título", "default": "#1a1a1a" },
        { "type": "color", "id": "accent_color", "label": "Color del acento", "default": "#a3157c" },
        { "type": "range", "id": "margin_bottom", "label": "Espacio inferior", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 8 }
      ]
    },
    {
      "type": "subtitulo",
      "name": "Subtítulo",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "En bolívares, con tarjeta internacional o en divisas. Siempre con un proceso ágil y seguro."
        },
        { "type": "font_picker", "id": "font", "label": "Fuente", "default": "poppins_n4" },
        { "type": "range", "id": "size_mobile", "label": "Tamaño en móvil", "unit": "px", "min": 12, "max": 24, "step": 1, "default": 14 },
        { "type": "range", "id": "size_desktop", "label": "Tamaño en escritorio", "unit": "px", "min": 12, "max": 28, "step": 1, "default": 15 },
        { "type": "color", "id": "color", "label": "Color del texto", "default": "#5c5550" },
        { "type": "range", "id": "max_width", "label": "Ancho máximo del texto", "unit": "ch", "min": 30, "max": 90, "step": 2, "default": 70 },
        { "type": "range", "id": "margin_bottom", "label": "Espacio inferior", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 28 }
      ]
    },
    {
      "type": "metodo",
      "name": "Método de pago",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Pago Móvil y transferencias" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Pago Móvil interbancario o transferencia desde cualquier banco en Venezuela. Rápido y sin complicaciones."
        },
        { "type": "text", "id": "badge", "label": "Insignia", "default": "Bolívares" },
        {
          "type": "text",
          "id": "chips",
          "label": "Chips (separados por coma)",
          "info": "Ejemplo: Pago Móvil, Transferencia. Un chip no puede contener comas.",
          "default": "Pago Móvil, Transferencia"
        },
        { "type": "font_picker", "id": "font", "label": "Fuente", "default": "poppins_n4" },

        { "type": "header", "content": "Ícono" },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "none", "label": "Sin ícono" },
            { "value": "transfer", "label": "Transferencia" },
            { "value": "card", "label": "Tarjeta" },
            { "value": "cash", "label": "Efectivo" },
            { "value": "phone", "label": "Teléfono" },
            { "value": "wallet", "label": "Billetera" },
            { "value": "shield", "label": "Escudo" }
          ],
          "default": "transfer"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Imagen de ícono propia", "info": "Reemplaza al ícono de la lista." },
        { "type": "range", "id": "icon_size", "label": "Tamaño del círculo", "unit": "px", "min": 32, "max": 80, "step": 2, "default": 48 },
        { "type": "color", "id": "icon_bg_color", "label": "Fondo del ícono", "default": "#ffd9f5" },
        { "type": "color", "id": "icon_color", "label": "Color del ícono", "default": "#a3157c" },

        { "type": "header", "content": "Tarjeta" },
        { "type": "color", "id": "card_bg_color", "label": "Fondo", "default": "#ffffff" },
        { "type": "color", "id": "card_border_color", "label": "Borde", "default": "#ece4dc" },
        { "type": "range", "id": "radius", "label": "Radio de las esquinas", "unit": "px", "min": 0, "max": 48, "step": 2, "default": 24 },
        { "type": "range", "id": "padding_y", "label": "Relleno vertical", "unit": "px", "min": 8, "max": 60, "step": 2, "default": 28 },
        { "type": "range", "id": "padding_x", "label": "Relleno lateral", "unit": "px", "min": 8, "max": 60, "step": 2, "default": 28 },
        { "type": "range", "id": "head_gap", "label": "Espacio bajo el ícono", "unit": "px", "min": 0, "max": 80, "step": 2, "default": 32 },

        { "type": "header", "content": "Textos" },
