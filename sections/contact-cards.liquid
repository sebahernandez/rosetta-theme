{%- liquid
  assign title_font = section.settings.title_font
-%}

{%- style -%}
  {{ title_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
  }
{%- endstyle -%}

{% stylesheet %}
  .contact-cards {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--cc-max-width);
    margin-inline: auto;
    padding: var(--cc-pt-m) var(--cc-px-m) var(--cc-pb-m);
  }

  .contact-cards__title {
    margin: 0 0 20px;
    font-family: var(--cc-title-font);
    font-weight: var(--cc-title-weight);
    font-size: var(--cc-title-size-m);
    line-height: 1.3;
    color: var(--cc-title-color);
    overflow-wrap: anywhere;
  }

  .contact-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--cc-cols-m), minmax(0, 1fr));
    align-items: stretch;
    gap: var(--cc-gap);
    --cc-pad: var(--cc-pad-m);
  }

  @media screen and (min-width: 750px) {
    .contact-cards {
      padding: var(--cc-pt-d) var(--cc-px-d) var(--cc-pb-d);
    }

    .contact-cards__title {
      font-size: var(--cc-title-size-d);
    }

    .contact-cards__grid {
      grid-template-columns: repeat(var(--cc-cols-t), minmax(0, 1fr));
      --cc-pad: var(--cc-pad-d);
    }
  }

  @media screen and (min-width: 990px) {
    .contact-cards__grid {
      grid-template-columns: repeat(var(--cc-cols-d), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

<div
  class="contact-cards"
  style="
    --cc-max-width: {{ section.settings.max_width }}px;
    --cc-pt-m: {{ section.settings.padding_top_mobile }}px;
    --cc-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --cc-px-m: {{ section.settings.padding_x_mobile }}px;
    --cc-pt-d: {{ section.settings.padding_top_desktop }}px;
    --cc-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --cc-px-d: {{ section.settings.padding_x_desktop }}px;
    --cc-title-font: {{ title_font.family }}, {{ title_font.fallback_families }};
    --cc-title-weight: {{ title_font.weight }};
    --cc-title-size-m: {{ section.settings.title_size_mobile | divided_by: 10.0 }}rem;
    --cc-title-size-d: {{ section.settings.title_size_desktop | divided_by: 10.0 }}rem;
    --cc-title-color: {{ section.settings.title_color }};
    --cc-cols-m: {{ section.settings.columns_mobile }};
    --cc-cols-t: {{ section.settings.columns_tablet }};
    --cc-cols-d: {{ section.settings.columns_desktop }};
    --cc-gap: {{ section.settings.gap }}px;
    --cc-radius: {{ section.settings.card_radius }}px;
    --cc-pad-m: {{ section.settings.card_padding_mobile }}px;
    --cc-pad-d: {{ section.settings.card_padding_desktop }}px;
  "
>
  {%- if section.settings.title != blank -%}
    <h2 class="contact-cards__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="contact-cards__grid">
      {%- content_for 'blocks' -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Tarjetas de contacto",
  "tag": "section",
  "class": "contact-cards-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Título" },
    { "type": "text", "id": "title", "label": "Título de la sección", "default": "Otras formas de contactarnos" },
    { "type": "font_picker", "id": "title_font", "label": "Fuente del título", "default": "assistant_n4" },
    { "type": "range", "id": "title_size_mobile", "label": "Tamaño del título en móvil", "unit": "px", "min": 12, "max": 40, "step": 1, "default": 16 },
    { "type": "range", "id": "title_size_desktop", "label": "Tamaño del título en escritorio", "unit": "px", "min": 12, "max": 56, "step": 1, "default": 18 },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#6b645e" },

    { "type": "header", "content": "Fondo y contenedor" },
    { "type": "color", "id": "section_bg", "label": "Fondo de la sección", "default": "#faf7f2" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo del contenido", "unit": "px", "min": 600, "max": 1800, "step": 20, "default": 1280 },

    { "type": "header", "content": "Cuadrícula" },
    { "type": "range", "id": "columns_desktop", "label": "Columnas en escritorio", "min": 1, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columnas en tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en móvil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "gap", "label": "Espacio entre tarjetas", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 20 },

    { "type": "header", "content": "Tarjetas (común a todas)" },
    { "type": "range", "id": "card_radius", "label": "Radio de las esquinas", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 32 },
    { "type": "range", "id": "card_padding_desktop", "label": "Relleno interno en escritorio", "unit": "px", "min": 8, "max": 80, "step": 2, "default": 26 },
    { "type": "range", "id": "card_padding_mobile", "label": "Relleno interno en móvil", "unit": "px", "min": 8, "max": 60, "step": 2, "default": 20 },

    { "type": "header", "content": "Espaciados: escritorio" },
    { "type": "range", "id": "padding_top_desktop", "label": "Relleno superior", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 20 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Relleno inferior", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_x_desktop", "label": "Relleno lateral", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 20 },

    { "type": "header", "content": "Espaciados: móvil" },
    { "type": "range", "id": "padding_top_mobile", "label": "Relleno superior", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Relleno inferior", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_x_mobile", "label": "Relleno lateral", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 16 }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Tarjetas de contacto",
      "blocks": {
        "whatsapp": {
          "type": "contact-card",
          "settings": {
            "icon": "whatsapp",
            "title": "WhatsApp",
            "value": "+58 412 000 0000",
            "description": "La vía más rápida para pedidos y pagos.",
            "link_text": "Abrir chat",
            "bg_color": "#6bffd1",
            "border_color": "#6bffd1",
            "icon_bg_color": "#ffffff",
            "icon_color": "#1a1a1a"
          }
        },
        "correo": {
          "type": "contact-card",
          "settings": {
            "icon": "mail",
            "title": "Correo",
            "value": "hola@rosettavzla.com",
            "description": "Para facturas y consultas detalladas.",
            "link_text": "Escribir correo"
          }
        },
        "delivery": {
          "type": "contact-card",
          "settings": {
            "icon": "clock",
            "title": "Delivery",
            "value": "Tucacas, estado Falcón",
            "description": "Entregas a domicilio o retiro en tienda.",
            "link_text": ""
          }
        }
      },
      "block_order": ["whatsapp", "correo", "delivery"]
    }
  ]
}
{% endschema %}
