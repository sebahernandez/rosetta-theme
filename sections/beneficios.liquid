{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    margin: {{ section.settings.margin_top }}px {{ section.settings.margin_x }}px {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% stylesheet %}
  .beneficios {
    overflow: hidden;
  }

  .beneficios__grid {
    display: grid;
    grid-template-columns: 1fr;
    margin: -1px 0 0;
    padding: 0;
    list-style: none;
  }

  .beneficios__item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    min-width: 0;
    padding: 24px 20px;
    box-sizing: border-box;
    border-top: 1px solid transparent;
  }

  .beneficios--dividers .beneficios__item {
    border-top-color: var(--ben-divider);
  }

  .beneficios__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--ben-circle);
    color: var(--ben-icon);
  }

  .beneficios__icon svg {
    display: block;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .beneficios__icon img {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .beneficios__text {
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: left;
  }

  .beneficios__title,
  .beneficios__desc {
    margin: 0;
  }

  .beneficios__title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ben-title);
  }

  .beneficios__desc {
    margin-top: 2px;
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--ben-text);
  }

  @media screen and (min-width: 750px) {
    .beneficios__grid {
      grid-template-columns: repeat(var(--ben-cols-tablet), 1fr);
      margin: 0 0 0 -1px;
    }

    .beneficios__item {
      justify-content: center;
      border-top: 0;
      border-left: 1px solid transparent;
    }

    .beneficios__text {
      text-align: inherit;
    }

    .beneficios--dividers .beneficios__item {
      border-top-color: transparent;
      border-left-color: var(--ben-divider);
    }
  }

  @media screen and (min-width: 990px) {
    .beneficios__grid {
      grid-template-columns: repeat(var(--ben-cols), 1fr);
    }
  }
{% endstylesheet %}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    unless block.settings.title == blank and block.settings.text == blank
      assign visible_count = visible_count | plus: 1
    endunless
  endfor
  assign cols = visible_count | at_most: 4
  assign cols_tablet = visible_count | at_most: 2
-%}

{%- if visible_count > 0 -%}
  <div
    class="beneficios{% if section.settings.show_dividers %} beneficios--dividers{% endif %}"
    style="--ben-divider: {{ section.settings.divider_color }}; --ben-cols: {{ cols }}; --ben-cols-tablet: {{ cols_tablet }};"
  >
    <ul class="beneficios__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.title == blank and block.settings.text == blank -%}
          {%- continue -%}
        {%- endif -%}
        <li
          class="beneficios__item"
          style="--ben-icon: {{ block.settings.icon_color }}; --ben-circle: {{ block.settings.circle_color }}; --ben-title: {{ block.settings.title_color }}; --ben-text: {{ block.settings.text_color }};"
          {{ block.shopify_attributes }}
        >
          <span class="beneficios__icon" aria-hidden="true">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 24, height: 24 }}
            {%- else -%}
              <svg viewBox="0 0 24 24" focusable="false">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  {%- when 'shield' -%}
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="M9 12l2 2 4-4"></path>
                  {%- when 'headset' -%}
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                  {%- when 'refresh' -%}
                    <polyline points="1 4 1 10 7 10"></polyline>
                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                  {%- when 'gift' -%}
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  {%- when 'clock' -%}
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  {%- when 'heart' -%}
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  {%- when 'star' -%}
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  {%- when 'card' -%}
                    <rect x="1" y="4" width="22" height="16" rx="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                  {%- when 'check' -%}
                    <polyline points="20 6 9 17 4 12"></polyline>
                {%- endcase -%}
              </svg>
            {%- endif -%}
          </span>
          <div class="beneficios__text">
            {%- if block.settings.title != blank -%}
              <p class="beneficios__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="beneficios__desc">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Beneficios",
  "tag": "section",
  "class": "beneficios-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Fondo de la sección",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Separadores"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Mostrar separadores",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color de los separadores",
      "default": "#ece7e1"
    },
    {
      "type": "header",
      "content": "Margen del contenedor"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_x",
      "label": "Margen lateral",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Relleno del contenedor"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Relleno superior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Relleno inferior",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Relleno lateral",
      "unit": "px",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "shield", "label": "Escudo" },
            { "value": "headset", "label": "Atención" },
            { "value": "refresh", "label": "Devolución" },
            { "value": "gift", "label": "Regalo" },
            { "value": "clock", "label": "Reloj" },
            { "value": "heart", "label": "Corazón" },
            { "value": "star", "label": "Estrella" },
            { "value": "card", "label": "Tarjeta" },
            { "value": "check", "label": "Check" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Imagen propia (reemplaza al ícono)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío gratuito"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descripción",
          "default": "Sin costo en tus pedidos."
        },
        {
          "type": "header",
          "content": "Colores"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Color del ícono",
          "default": "#a3138f"
        },
        {
          "type": "color",
          "id": "circle_color",
          "label": "Color del círculo de fondo",
          "default": "#fde7f8"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Color del título",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color de la descripción",
          "default": "#6b6b6b"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beneficios",
      "blocks": [
        {
          "type": "beneficio",
          "settings": {
            "icon": "truck",
            "title": "Envío gratuito",
            "text": "Sin costo en tus pedidos."
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "icon": "shield",
            "title": "Pago seguro",
            "text": "Transacciones protegidas."
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "icon": "headset",
            "title": "Atención 24/7",
            "text": "Soporte todo el día."
          }
        },
        {
          "type": "beneficio",
          "settings": {
            "icon": "refresh",
            "title": "Devolución garantizada",
            "text": "Hasta 30 días para volver."
          }
        }
      ]
    }
  ]
}
{% endschema %}
