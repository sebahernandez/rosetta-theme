{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if settings.predictive_search_enabled -%}
  <script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<style>
  .custom-search {
    margin: 0 auto;
  }

  .custom-search .search {
    margin-top: 0;
  }

  .custom-search__header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: {{ section.settings.spacing_bottom }}px;
  }

  .custom-search__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .custom-search .search__input {
    font-size: {{ section.settings.input_font_size }}px;
    padding: {{ section.settings.input_padding }}px{{ section.settings.input_padding | times: 1.5 }}px;
  }

  .custom-search .search__input:focus {
    outline: none;
    box-shadow: none;
    border-color: inherit;
  }

  .custom-search .search__button {
    background-color: {{ section.settings.button_color }};
  }

  .custom-search .search__button:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  {% if section.settings.background_color != blank %}
    .custom-search-section {
      background-color: {{ section.settings.background_color }};
    }
  {% endif %}

  {% if section.settings.border_radius > 0 %}
    .custom-search .field__input,
    .custom-search .search__button {
      border-radius: {{ section.settings.border_radius }}px;
    }
  {% endif %}
</style>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-search-section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="custom-search{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">

      {%- if section.settings.show_heading -%}
        <div class="custom-search__header">
          <h2 class="{{ section.settings.heading_size }}">
            {{ section.settings.heading | default: 'Buscar' }}
          </h2>
          {%- if section.settings.subheading != blank -%}
            <p class="custom-search__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="custom-search__container">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}

        <main-search>
          <form
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-{{ section.id }}"
                type="search"
                name="q"
                value=""
                placeholder="{{ section.settings.placeholder_text | default: 'Buscar productos...' }}"
                {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results-{{ section.id }}"
                aria-controls="predictive-search-results-{{ section.id }}"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                {%- endif -%}>
              <label class="field__label" for="Search-{{ section.id }}">
                {{ section.settings.label_text | default: 'Buscar' }}
              </label>
              <input
                name="options[prefix]"
                type="hidden"
                value="last">

              {%- if settings.predictive_search_enabled -%}
                <div
                  class="predictive-search"
                  tabindex="-1"
                  data-predictive-search>
                  {%- render 'loading-spinner'
                    , class: 'predictive-search__loading-state' -%}
                </div>
                <span
                  class="predictive-search-status visually-hidden"
                  role="status"
                  aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button hidden"
                aria-label="{{ 'general.search.reset' | t }}">
                <span class="svg-wrapper">
                  {{- 'icon-reset.svg' | inline_asset_content -}}
                </span>
              </button>

              <button
                type="submit"
                class="search__button field__button"
                aria-label="{{ section.settings.button_label | default: 'Buscar' }}">
                <span class="svg-wrapper">
                  {{- 'icon-search.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </form>
        </main-search>

        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Buscador Personalizado",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "header",
        "content": "Configuración del Título"
      },
      {
        "type": "checkbox",
        "id": "show_heading",
        "default": true,
        "label": "Mostrar título"
      },
      {
        "type": "text",
        "id": "heading",
        "default": "¿Qué estás buscando?",
        "label": "Título"
      },
      {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h3",
            "label": "Pequeño"
          }, {
            "value": "h2",
            "label": "Mediano"
          }, {
            "value": "h1",
            "label": "Grande"
          }
        ],
        "default": "h2",
        "label": "Tamaño del título"
      }, {
        "type": "textarea",
        "id": "subheading",
        "label": "Subtítulo",
        "info": "Texto opcional debajo del título principal"
      }, {
        "type": "select",
        "id": "text_alignment",
        "options": [
          {
            "value": "left",
            "label": "Izquierda"
          }, {
            "value": "center",
            "label": "Centro"
          }, {
            "value": "right",
            "label": "Derecha"
          }
        ],
        "default": "center",
        "label": "Alineación del texto"
      }, {
        "type": "header",
        "content": "Configuración del Campo de Búsqueda"
      }, {
        "type": "text",
        "id": "label_text",
        "default": "¿Qué estás buscando?",
        "label": "Etiqueta del campo",
        "info": "Texto que aparece como label del input"
      }, {
        "type": "text",
        "id": "placeholder_text",
        "default": "Buscar productos...",
        "label": "Texto de placeholder",
        "info": "Texto que aparece dentro del campo cuando está vacío"
      }, {
        "type": "text",
        "id": "button_label",
        "default": "Buscar",
        "label": "Etiqueta del botón"
      }, {
        "type": "range",
        "id": "input_font_size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Tamaño de fuente",
        "default": 16
      }, {
        "type": "range",
        "id": "input_padding",
        "min": 8,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Espaciado interno",
        "default": 12
      }, {
        "type": "header",
        "content": "Estilo y Colores"
      }, {
        "type": "color",
        "id": "button_color",
        "label": "Color del botón",
        "default": "#FF71DB"
      }, {
        "type": "color",
        "id": "button_hover_color",
        "label": "Color del botón al pasar el mouse",
        "default": "#E655C5"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Color de fondo de la sección",
        "info": "Dejar vacío para usar el color por defecto del tema"
      }, {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Bordes redondeados",
        "default": 4
      }, {
        "type": "header",
        "content": "Configuración del Layout"
      }, {
        "type": "range",
        "id": "max_width",
        "min": 400,
        "max": 1200,
        "step": 50,
        "unit": "px",
        "label": "Ancho máximo del buscador",
        "default": 600
      }, {
        "type": "range",
        "id": "spacing_bottom",
        "min": 0,
        "max": 60,
        "step": 4,
        "unit": "px",
        "label": "Espacio debajo del título",
        "default": 20
      }, {
        "type": "header",
        "content": "Espaciado de la Sección"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Espaciado superior",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Espaciado inferior",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Buscador Personalizado"
      }
    ]
  }
{% endschema %}