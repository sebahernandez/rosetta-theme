{% schema %}
  {
    "name": "Cuadrícula de categorías",
    "tag": "section",
    "class": "image-slider-section",
    "settings": [
      {
        "type": "header",
        "content": "Configuración de la cuadrícula"
      }, {
        "type": "range",
        "id": "gap_size",
        "min": 0,
        "max": 3,
        "step": 0.5,
        "unit": "rem",
        "label": "Espacio entre imágenes",
        "default": 1
      }, {
        "type": "select",
        "id": "aspect_ratio_desktop",
        "label": "Proporción de las cajas (escritorio)",
        "info": "Adaptar a la imagen usa la proporción de la primera imagen para todas las cajas.",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Adaptar a la imagen (sin recorte)"
          },
          {
            "value": "1/1",
            "label": "Cuadrada (1:1)"
          }, {
            "value": "4/3",
            "label": "Horizontal (4:3)"
          }, {
            "value": "3/4",
            "label": "Vertical (3:4)"
          }, {
            "value": "16/9",
            "label": "Panorámica (16:9)"
          }
        ]
      }, {
        "type": "select",
        "id": "aspect_ratio_mobile",
        "label": "Proporción de las cajas (móvil)",
        "info": "Adaptar a la imagen usa la proporción de la primera imagen para todas las cajas.",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Adaptar a la imagen (sin recorte)"
          },
          {
            "value": "1/1",
            "label": "Cuadrada (1:1)"
          }, {
            "value": "4/3",
            "label": "Horizontal (4:3)"
          }, {
            "value": "3/4",
            "label": "Vertical (3:4)"
          }, {
            "value": "16/9",
            "label": "Panorámica (16:9)"
          }
        ]
      }, {
        "type": "header",
        "content": "Espaciado de la sección"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Relleno superior",
        "default": 50
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Relleno inferior",
        "default": 50
      }, {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Margen superior",
        "default": 0
      }, {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Margen inferior",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "category_image",
        "name": "Imagen de Categoría",
        "settings": [
          {
            "type": "text",
            "id": "category_title",
            "label": "Título de la categoría",
            "default": "Categoría destacada"
          }, {
            "type": "image_picker",
            "id": "category_image",
            "label": "Imagen de la categoría (escritorio)"
          }, {
            "type": "image_picker",
            "id": "category_image_mobile",
            "label": "Imagen de la categoría (móvil)",
            "info": "Opcional. Se muestra en pantallas de menos de 750px. Si no se selecciona, se usa la imagen de escritorio."
          }, {
            "type": "collection",
            "id": "target_collection",
            "label": "Colección de destino"
          }, {
            "type": "text",
            "id": "image_alt",
            "label": "Texto alternativo de la imagen",
            "info": "Describe la imagen para accesibilidad"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Cuadrícula de categorías",
        "category": "Secciones personalizadas",
        "blocks": [
          {
            "type": "category_image"
          }, {
            "type": "category_image"
          }, {
            "type": "category_image"
          }, {
            "type": "category_image"
          }
        ]
      }
    ]
  }

{% endschema %}

<section
  style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;"
>
  <div class="page-width">
    {%- liquid
      assign ratio_desktop = section.settings.aspect_ratio_desktop | default: 'auto'
      assign ratio_mobile = section.settings.aspect_ratio_mobile | default: 'auto'

      if ratio_desktop == 'auto' or ratio_mobile == 'auto'
        assign first_ratio_desktop = 1
        assign first_ratio_mobile = 1
        for block in section.blocks
          if block.settings.category_image != blank
            assign first_ratio_desktop = block.settings.category_image.aspect_ratio
            assign first_ratio_mobile = block.settings.category_image_mobile.aspect_ratio | default: first_ratio_desktop
            break
          endif
        endfor
        if ratio_desktop == 'auto'
          assign ratio_desktop = first_ratio_desktop
        endif
        if ratio_mobile == 'auto'
          assign ratio_mobile = first_ratio_mobile
        endif
      endif
    -%}
    <div
      class="category-grid"
      style="--category-gap: {{ section.settings.gap_size | default: 0 }}rem; --category-ratio-desktop: {{ ratio_desktop }}; --category-ratio-mobile: {{ ratio_mobile }};"
    >
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category_image' %}
            {% assign image = block.settings.category_image %}
            {% assign image_mobile = block.settings.category_image_mobile %}
            {% assign image_alt = block.settings.image_alt | default: block.settings.category_title %}
            <div class="category-grid__item" {{ block.shopify_attributes }}>
              {% if block.settings.target_collection != blank %}
                <a href="{{ collections[block.settings.target_collection].url }}" class="category-slide__link">
              {% endif %}

              {% if image != blank %}
                <picture>
                  {% if image_mobile != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ image_mobile | image_url: width: 375 }} 375w, {{ image_mobile | image_url: width: 550 }} 550w, {{ image_mobile | image_url: width: 750 }} 750w"
                      sizes="50vw"
                      width="{{ image_mobile.width }}"
                      height="{{ image_mobile.height }}"
                    >
                  {% endif %}
                  {{
                    image
                    | image_url: width: 1100
                    | image_tag:
                      widths: '375, 550, 750, 1100',
                      sizes: '(min-width: 750px) 25vw, 50vw',
                      loading: 'lazy',
                      alt: image_alt,
                      class: 'category-slide__image'
                  }}
                </picture>
              {% else %}
                <div class="category-slide__placeholder">
                  <span>{{ block.settings.category_title }}</span>
                </div>
              {% endif %}

              {% if block.settings.category_title != blank %}
                <div class="category-slide__overlay">
                  <h3 class="category-slide__title">{{ block.settings.category_title }}</h3>
                </div>
              {% endif %}

              {% if block.settings.target_collection != blank %}
                </a>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

  </div>

</section>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--category-gap, 1rem);
  }

  .category-grid__item {
    position: relative;
    aspect-ratio: var(--category-ratio-mobile, 1/1);
    overflow: hidden;
    border-radius: 8px;
  }

  .category-grid__item picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .category-slide__link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .category-slide__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .category-slide__link:hover .category-slide__image {
    transform: scale(1.05);
  }

  .category-slide__placeholder {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 2px dashed #ccc;
  }

  .category-slide__placeholder span {
    color: #666;
    font-size: 14px;
    text-align: center;
  }

  .category-slide__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    padding: 20px 15px 15px;
    border-radius: 0 0 8px 8px;
  }

  .category-slide__title {
    color: white;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .category-slide__title {
      font-size: 14px;
    }
  }

  @media screen and (min-width: 750px) {
    .category-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .category-grid__item {
      aspect-ratio: var(--category-ratio-desktop, 1/1);
    }
  }
</style>
