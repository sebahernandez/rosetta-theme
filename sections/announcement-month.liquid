{% schema %}
  {
    "name": "Promociones del mes",
    "settings": [
      {
        "type": "header",
        "content": "Configuración general"
      }, {
        "type": "range",
        "id": "margin_top",
        "label": "Margen superior (px)",
        "min": 0,
        "max": 200,
        "step": 10,
        "default": 40
      }, {
        "type": "range",
        "id": "margin_bottom",
        "label": "Margen inferior (px)",
        "min": 0,
        "max": 200,
        "step": 10,
        "default": 40
      }
    ],
    "blocks": [
      {
        "type": "promo",
        "name": "Promoción",
        "settings": [
          {
            "type": "header",
            "content": "Información general"
          },
          {
            "type": "text",
            "id": "titulo",
            "label": "Título de la promoción",
            "default": "Promoción del mes"
          },
          {
            "type": "url",
            "id": "enlace",
            "label": "Enlace"
          },
          {
            "type": "header",
            "content": "Imágenes y textos alternativos"
          }, {
            "type": "image_picker",
            "id": "imagen_desktop",
            "label": "Imagen (Desktop)"
          }, {
            "type": "text",
            "id": "alt_desktop",
            "label": "Texto alternativo - Desktop",
            "default": "Promoción del mes",
            "info": "Descripción de la imagen para desktop (SEO y accesibilidad)"
          }, {
            "type": "image_picker",
            "id": "imagen_tablet",
            "label": "Imagen (Tablet)",
            "info": "Opcional. Si no se selecciona, se usará la imagen de desktop."
          }, {
            "type": "text",
            "id": "alt_tablet",
            "label": "Texto alternativo - Tablet",
            "info": "Opcional. Si está vacío, se usará el texto alternativo de desktop"
          }, {
            "type": "image_picker",
            "id": "imagen_mobile",
            "label": "Imagen (Mobile)",
            "info": "Opcional. Si no se selecciona, se usará la imagen de desktop."
          }, {
            "type": "text",
            "id": "alt_mobile",
            "label": "Texto alternativo - Mobile",
            "info": "Opcional. Si está vacío, se usará el texto alternativo de desktop"
          }, {
            "type": "header",
            "content": "Configuración de visualización"
          }, {
            "type": "text",
            "id": "alt_text",
            "label": "Texto alternativo general",
            "default": "Promoción del mes",
            "info": "Texto alternativo general (se usa como fallback si no se especifica para cada imagen)"
          }, {
            "type": "select",
            "id": "image_fit",
            "label": "Ajuste de imagen",
            "default": "cover",
            "options": [
              {
                "value": "cover",
                "label": "Cubrir (Cover)"
              }, {
                "value": "contain",
                "label": "Contener (Contain)"
              }, {
                "value": "fill",
                "label": "Llenar (Fill)"
              }, {
                "value": "scale-down",
                "label": "Escalar hacia abajo"
              }
            ]
          }, {
            "type": "range",
            "id": "mobile_height",
            "label": "Altura en móvil (px)",
            "min": 50,
            "max": 500,
            "step": 10,
            "default": 200,
            "info": "Altura específica para esta promoción en dispositivos móviles"
          }, {
            "type": "range",
            "id": "mobile_width",
            "label": "Ancho máximo en móvil (px)",
            "min": 200,
            "max": 500,
            "step": 10,
            "default": 350,
            "info": "Ancho máximo para esta promoción en dispositivos móviles"
          }, {
            "type": "header",
            "content": "Configuración tablet"
          }, {
            "type": "range",
            "id": "tablet_height",
            "label": "Altura en tablet (px)",
            "min": 200,
            "max": 600,
            "step": 10,
            "default": 250,
            "info": "Altura específica para esta promoción en tablets"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Promociones del mes",
        "category": "Secciones personalizadas",
        "blocks": [
          {
            "type": "promo",
            "settings": {
              "titulo": "Viña del mes",
              "alt_text": "Promoción vinos del mes"
            }
          }, {
            "type": "promo",
            "settings": {
              "titulo": "Cerveza del mes",
              "alt_text": "Promoción cervezas del mes"
            }
          }, {
            "type": "promo",
            "settings": {
              "titulo": "Queso del mes",
              "alt_text": "Promoción quesos del mes"
            }
          }
        ]
      }
    ]
  }
{% endschema %}

{% style %}
  .announcement-month-section {
    margin-top: {{ section.settings.margin_top | default: 40 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 40 }}px;
  }

  .promos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto;
    gap: 20px;
    margin: 0 auto;
  }

  .promo-item {
    background: #fef4ee;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .promo-item:first-child {
    grid-column: span 2;
  }

  .promo-item img {
    width: 100%;
    height: 100%;
    display: block;
    object-position: center;
    transition: transform 0.3s ease;
  }

  .promo-image-desktop {
    display: block;
  }

  .promo-image-tablet {
    display: none;
  }

  .promo-image-mobile {
    display: none;
  }

  .promo-item a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .promo-item a:hover img {
    transform: scale(1.05);
  }

  /* Desktop: Only show desktop images */
  @media screen and (min-width: 1025px) {
    .promo-image-desktop {
      display: block;
    }

    .promo-image-tablet {
      display: none !important;
    }

    .promo-image-mobile {
      display: none !important;
    }
  }

  /* Mobile responsive */
  @media screen and (max-width: 768px) {
    .promos-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(auto);
      gap: 15px;
    }

    .promo-item:first-child {
      grid-column: span 1;
    }

    /* Hide desktop and tablet images on mobile */
    .promo-image-desktop:not(.promo-image-mobile-fallback) {
      display: none;
    }

    .promo-image-tablet {
      display: none;
    }

    /* Show mobile image if available */
    .promo-image-mobile {
      display: block;
    }

    /* Individual block heights for mobile */
    {% for block in section.blocks %}
      .promo-item[data-block-id="{{ block.id }}"] {
        height: {{ block.settings.mobile_height | default: 200 }}px;
        min-height: {{ block.settings.mobile_height | default: 200 }}px;
        max-width: {{ block.settings.mobile_width | default: 350 }}px;
      }
    {% endfor %}
  }

  /* Tablet responsive */
  @media screen and (min-width: 769px) and(max-width: 1024px) {
    .promos-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, auto);
      gap: 15px;
    }

    .promo-item:first-child {
      grid-column: span 2;
      grid-row: span 1;
    }

    /* Hide desktop and mobile images on tablet */
    .promo-image-desktop:not(.promo-image-tablet-fallback) {
      display: none;
    }

    .promo-image-mobile {
      display: none;
    }

    /* Show tablet image if available */
    .promo-image-tablet {
      display: block;
    }

    /* Individual block heights for tablet */
    {% for block in section.blocks %}
      .promo-item[data-block-id="{{ block.id }}"] {
        height: {{ block.settings.tablet_height | default: 250 }}px;
        min-height: {{ block.settings.tablet_height | default: 250 }}px;
      }
    {% endfor %}
  }
{% endstyle %}

<section class="announcement-month-section">
  <div class="promos-grid page-width">
    {% for block in section.blocks %}
      <div
        class="promo-item"
        data-block-id="{{ block.id }}"
        {{ block.shopify_attributes }}>
        {% if block.settings.enlace != blank %}
          <a href="{{ block.settings.enlace }}">
            <img
              src="{{ block.settings.imagen_desktop | image_url }}"
              alt="{{ block.settings.alt_desktop | default: block.settings.alt_text | default: block.settings.titulo }}"
              class="promo-image-desktop {% if block.settings.imagen_tablet == blank %}promo-image-tablet-fallback{% endif %} {% if block.settings.imagen_mobile == blank %}promo-image-mobile-fallback{% endif %}"
              style="object-fit: {{ block.settings.image_fit | default: 'cover' }};">
            {% if block.settings.imagen_tablet != blank %}
              <img
                src="{{ block.settings.imagen_tablet | image_url }}"
                alt="{{ block.settings.alt_tablet | default: block.settings.alt_desktop | default: block.settings.alt_text | default: block.settings.titulo }}"
                class="promo-image-tablet"
                style="object-fit: {{ block.settings.image_fit | default: 'cover' }};">
            {% endif %}
            {% if block.settings.imagen_mobile != blank %}
              <img
                src="{{ block.settings.imagen_mobile | image_url }}"
                alt="{{ block.settings.alt_mobile | default: block.settings.alt_desktop | default: block.settings.alt_text | default: block.settings.titulo }}"
                class="promo-image-mobile"
                style="object-fit: {{ block.settings.image_fit | default: 'cover' }};">
            {% endif %}
          </a>
        {% else %}
          <img
            src="{{ block.settings.imagen_desktop | image_url }}"
            alt="{{ block.settings.alt_desktop | default: block.settings.alt_text | default: block.settings.titulo }}"
            class="promo-image-desktop {% if block.settings.imagen_tablet == blank %}promo-image-tablet-fallback{% endif %} {% if block.settings.imagen_mobile == blank %}promo-image-mobile-fallback{% endif %}"
            style="object-fit: {{ block.settings.image_fit | default: 'cover' }};">
          {% if block.settings.imagen_tablet != blank %}
            <img
              src="{{ block.settings.imagen_tablet | image_url }}"
              alt="{{ block.settings.alt_tablet | default: block.settings.alt_desktop | default: block.settings.alt_text | default: block.settings.titulo }}"
              class="promo-image-tablet"
              style="object-fit: {{ block.settings.image_fit | default: 'cover' }};">
          {% endif %}
          {% if block.settings.imagen_mobile != blank %}
            <img
              src="{{ block.settings.imagen_mobile | image_url }}"
              alt="{{ block.settings.alt_mobile | default: block.settings.alt_desktop | default: block.settings.alt_text | default: block.settings.titulo }}"
              class="promo-image-mobile"
              style="object-fit: {{ block.settings.image_fit | default: 'cover' }};">
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>