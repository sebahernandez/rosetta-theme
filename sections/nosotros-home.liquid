{%- liquid
  assign columns = 'left,right' | split: ','
  assign left_count = 0
  assign right_count = 0
  for block in section.blocks
    if block.settings.column == 'right'
      assign right_count = right_count | plus: 1
    else
      assign left_count = left_count | plus: 1
    endif
  endfor

  assign ratio = section.settings.columns_ratio
  case ratio
    when '45-55'
      assign grid_cols = '45fr 55fr'
    when '40-60'
      assign grid_cols = '40fr 60fr'
    else
      assign grid_cols = '1fr 1fr'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
  }
{%- endstyle -%}

{% stylesheet %}
  .nh {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--nh-gap-m);
    width: 100%;
    max-width: var(--nh-max-width);
    margin-inline: auto;
    padding: var(--nh-pt-m) var(--nh-px-m) var(--nh-pb-m);
  }

  .nh *,
  .nh *::before,
  .nh *::after {
    box-sizing: border-box;
  }

  .nh__col {
    min-width: 0;
  }

  .nh__col--left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 12px;
  }

  .nh__col--right {
    position: relative;
  }

  .nh__item {
    flex: 0 0 100%;
    min-width: 0;
    margin-bottom: var(--nh-mb, 0px);
  }

  .nh__item--boton {
    flex: 1 1 100%;
  }

  .nh__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 8px 14px;
    border-radius: 999px;
    background-color: var(--nh-badge-bg);
    color: var(--nh-badge-text);
    font-size: var(--nh-badge-size);
    line-height: 1.2;
  }

  .nh__badge-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--nh-badge-dot);
  }

  .nh__title {
    margin: 0;
    font-family: var(--nh-font);
    font-weight: var(--nh-weight);
    font-size: var(--nh-size-m);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--nh-color);
    overflow-wrap: anywhere;
  }

  .nh__title-accent {
    font-style: italic;
    color: var(--nh-accent);
  }

  .nh__text {
    max-width: var(--nh-measure);
    margin: 0;
    font-family: var(--nh-font);
    font-weight: var(--nh-weight);
    font-size: var(--nh-size-m);
    line-height: 1.55;
    color: var(--nh-color);
    overflow-wrap: anywhere;
  }

  .nh__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 48px;
    padding: 0 28px;
    border: 1px solid var(--nh-btn-border);
    border-radius: 999px;
    background-color: var(--nh-btn-bg);
    color: var(--nh-btn-text);
    font-family: inherit;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .nh__button:hover {
    background-color: var(--nh-btn-hover);
  }

  .nh__button:focus-visible {
    outline: 2px solid var(--nh-btn-text);
    outline-offset: 2px;
  }

  .nh__button svg {
    display: block;
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nh__media {
    overflow: hidden;
    border-radius: var(--nh-radius);
    aspect-ratio: var(--nh-ratio);
    background-color: rgba(0, 0, 0, 0.06);
  }

  .nh__media img,
  .nh__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--nh-focal, 50% 50%);
  }

  .nh__item--tarjeta {
    position: absolute;
    bottom: 12px;
    flex: none;
    max-width: calc(100% - 24px);
    margin: 0;
  }

  .nh__item--tarjeta.nh__card--right {
    right: 12px;
  }

  .nh__item--tarjeta.nh__card--left {
    left: 12px;
  }

  .nh__card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--nh-radius);
    background-color: var(--nh-card-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .nh__card-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--nh-icon-bg);
    color: var(--nh-icon-color);
  }

  .nh__card-icon svg {
    display: block;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nh__card-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nh__card-body {
    min-width: 0;
  }

  .nh__card-title,
  .nh__card-sub {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .nh__card-title {
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--nh-card-title);
  }

  .nh__card-sub {
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--nh-card-sub);
  }

  @media screen and (min-width: 750px) {
    .nh {
      gap: var(--nh-gap-d);
      padding: var(--nh-pt-d) var(--nh-px-d) var(--nh-pb-d);
    }

    .nh__title,
    .nh__text {
      font-size: var(--nh-size-d);
    }

    .nh__item--boton {
      flex: 0 0 auto;
    }

    .nh__button {
      width: auto;
    }

    .nh__item--tarjeta {
      bottom: 24px;
    }

    .nh__item--tarjeta.nh__card--right {
      right: 24px;
    }

    .nh__item--tarjeta.nh__card--left {
      left: 24px;
    }

    .nh__card {
      gap: 14px;
      padding: 14px 20px;
    }

    .nh__card-title {
      font-size: 1.5rem;
    }

    .nh__card-sub {
      font-size: 1.2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .nh:not(.nh--single) {
      grid-template-columns: var(--nh-grid-cols);
    }
  }
{% endstylesheet %}

<div
  class="nh{% if left_count == 0 or right_count == 0 %} nh--single{% endif %}"
  style="
    --nh-max-width: {{ section.settings.max_width }}px;
    --nh-grid-cols: {{ grid_cols }};
    --nh-gap-m: {{ section.settings.gap_mobile }}px;
    --nh-gap-d: {{ section.settings.gap_desktop }}px;
    --nh-pt-m: {{ section.settings.padding_top_mobile }}px;
    --nh-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --nh-px-m: {{ section.settings.padding_x_mobile }}px;
    --nh-pt-d: {{ section.settings.padding_top_desktop }}px;
    --nh-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --nh-px-d: {{ section.settings.padding_x_desktop }}px;
  "
>
  {%- for col in columns -%}
    {%- assign col_count = left_count -%}
    {%- if col == 'right' -%}
      {%- assign col_count = right_count -%}
    {%- endif -%}
    {%- if col_count == 0 -%}
      {%- continue -%}
    {%- endif -%}
    <div class="nh__col nh__col--{{ col }}">
      {%- for block in section.blocks -%}
        {%- assign block_col = block.settings.column | default: 'left' -%}
        {%- if block_col != col -%}
          {%- continue -%}
        {%- endif -%}

        {%- case block.type -%}
          {%- when 'insignia' -%}
            {%- if block.settings.text != blank -%}
              <div
                class="nh__item nh__item--insignia"
                style="
                  --nh-mb: {{ block.settings.margin_bottom }}px;
                  --nh-badge-bg: {{ block.settings.bg_color }};
                  --nh-badge-text: {{ block.settings.text_color }};
                  --nh-badge-dot: {{ block.settings.dot_color }};
                  --nh-badge-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
                "
                {{ block.shopify_attributes }}
              >
                <p class="nh__badge" style="margin: 0;">
                  <span class="nh__badge-dot" aria-hidden="true"></span>
                  {{ block.settings.text | escape }}
                </p>
              </div>
            {%- endif -%}

          {%- when 'titulo' -%}
            {%- if block.settings.text != blank or block.settings.accent != blank -%}
              {%- assign t_font = block.settings.font -%}
              {%- assign t_font_italic = t_font | font_modify: 'style', 'italic' -%}
              {%- style -%}
                {{ t_font | font_face: font_display: 'swap' }}
                {{ t_font_italic | font_face: font_display: 'swap' }}
              {%- endstyle -%}
              <div
                class="nh__item nh__item--titulo"
                style="
                  --nh-mb: {{ block.settings.margin_bottom }}px;
                  --nh-font: {{ t_font.family }}, {{ t_font.fallback_families }};
                  --nh-weight: {{ t_font.weight }};
                  --nh-size-m: {{ block.settings.size_mobile | divided_by: 10.0 }}rem;
                  --nh-size-d: {{ block.settings.size_desktop | divided_by: 10.0 }}rem;
                  --nh-color: {{ block.settings.color }};
                  --nh-accent: {{ block.settings.accent_color }};
                "
                {{ block.shopify_attributes }}
              >
                <{{ block.settings.heading_level }} class="nh__title">
                  {{- block.settings.text | escape -}}
                  {%- if block.settings.accent != blank %} <span class="nh__title-accent">{{ block.settings.accent | escape }}</span>{% endif -%}
                </{{ block.settings.heading_level }}>
              </div>
            {%- endif -%}

          {%- when 'texto' -%}
            {%- if block.settings.text != blank -%}
              {%- assign x_font = block.settings.font -%}
              {%- style -%}
                {{ x_font | font_face: font_display: 'swap' }}
              {%- endstyle -%}
              <div
                class="nh__item nh__item--texto"
                style="
                  --nh-mb: {{ block.settings.margin_bottom }}px;
                  --nh-font: {{ x_font.family }}, {{ x_font.fallback_families }};
                  --nh-weight: {{ x_font.weight }};
                  --nh-size-m: {{ block.settings.size_mobile | divided_by: 10.0 }}rem;
                  --nh-size-d: {{ block.settings.size_desktop | divided_by: 10.0 }}rem;
                  --nh-color: {{ block.settings.color }};
                  --nh-measure: {{ block.settings.max_width }}ch;
                "
                {{ block.shopify_attributes }}
              >
                <p class="nh__text">{{ block.settings.text | escape }}</p>
              </div>
            {%- endif -%}

          {%- when 'boton' -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}
              <div
                class="nh__item nh__item--boton"
                style="
                  --nh-mb: {{ block.settings.margin_bottom }}px;
                  --nh-btn-bg: {{ block.settings.bg_color }};
                  --nh-btn-text: {{ block.settings.text_color }};
                  --nh-btn-border: {{ block.settings.border_color }};
                  --nh-btn-hover: {{ block.settings.hover_bg_color }};
                "
                {{ block.shopify_attributes }}
              >
                <a href="{{ block.settings.link }}" class="nh__button">
                  <span>{{ block.settings.label | escape }}</span>
                  {%- if block.settings.show_arrow -%}
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M2 8h12M9 3l5 5-5 5"></path>
                    </svg>
                  {%- endif -%}
                </a>
              </div>
            {%- endif -%}

          {%- when 'imagen' -%}
            <div
              class="nh__item nh__item--imagen"
              style="
                --nh-mb: {{ block.settings.margin_bottom }}px;
                --nh-radius: {{ block.settings.radius }}px;
                --nh-ratio: {{ block.settings.ratio }};
                {%- if block.settings.image.presentation.focal_point != blank %}
                  --nh-focal: {{ block.settings.image.presentation.focal_point }};
                {%- endif %}
              "
              {{ block.shopify_attributes }}
            >
              <div class="nh__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1400',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: block.settings.image_alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
            </div>

          {%- when 'tarjeta' -%}
            {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
              <div
                class="nh__item nh__item--tarjeta nh__card--{{ block.settings.position }}"
                style="
                  --nh-radius: {{ block.settings.radius }}px;
                  --nh-card-bg: {{ block.settings.bg_color }};
                  --nh-icon-bg: {{ block.settings.icon_bg_color }};
                  --nh-icon-color: {{ block.settings.icon_color }};
                  --nh-card-title: {{ block.settings.title_color }};
                  --nh-card-sub: {{ block.settings.subtitle_color }};
                "
                {{ block.shopify_attributes }}
              >
                <div class="nh__card">
                  {%- if block.settings.icon_image != blank or block.settings.icon != 'none' -%}
                    <span class="nh__card-icon" aria-hidden="true">
                      {%- if block.settings.icon_image != blank -%}
                        {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24" focusable="false">
                          {%- case block.settings.icon -%}
                            {%- when 'pin' -%}
                              <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path>
                              <circle cx="12" cy="10" r="2.5"></circle>
                            {%- when 'clock' -%}
                              <circle cx="12" cy="12" r="9"></circle>
                              <path d="M12 7v5l3 2"></path>
                            {%- when 'phone' -%}
                              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
                            {%- when 'chat' -%}
                              <path d="M4 5h16v11H9l-5 4V5z"></path>
                            {%- when 'mail' -%}
                              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                              <path d="M3 7l9 6 9-6"></path>
                            {%- when 'truck' -%}
                              <path d="M2 6h11v10H2z"></path>
                              <path d="M13 9h4l4 4v3h-8z"></path>
                              <circle cx="6.5" cy="17.5" r="1.8"></circle>
                              <circle cx="17.5" cy="17.5" r="1.8"></circle>
                          {%- endcase -%}
                        </svg>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <div class="nh__card-body">
                    {%- if block.settings.title != blank -%}
                      <p class="nh__card-title">{{ block.settings.title | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <p class="nh__card-sub">{{ block.settings.subtitle | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Nosotros Home",
  "tag": "section",
  "class": "nosotros-home-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Fondo y contenedor" },
    { "type": "color", "id": "section_bg", "label": "Fondo de la sección", "default": "#faf7f2" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo del contenido", "unit": "px", "min": 800, "max": 1800, "step": 20, "default": 1280 },
    {
      "type": "select",
      "id": "columns_ratio",
      "label": "Proporción de las columnas (escritorio)",
      "options": [
        { "value": "50-50", "label": "50 / 50" },
        { "value": "45-55", "label": "45 / 55" },
        { "value": "40-60", "label": "40 / 60" }
      ],
      "default": "45-55"
    },

    { "type": "header", "content": "Espaciados: escritorio" },
    { "type": "range", "id": "gap_desktop", "label": "Espacio entre columnas", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_top_desktop", "label": "Relleno superior", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Relleno inferior", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_x_desktop", "label": "Relleno lateral", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 24 },

    { "type": "header", "content": "Espaciados: móvil" },
    { "type": "range", "id": "gap_mobile", "label": "Espacio entre bloques de columnas", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 28 },
    { "type": "range", "id": "padding_top_mobile", "label": "Relleno superior", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Relleno inferior", "unit": "px", "min": 0, "max": 120, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_x_mobile", "label": "Relleno lateral", "unit": "px", "min": 0, "max": 60, "step": 2, "default": 16 }
  ],
  "blocks": [
    {
      "type": "insignia",
      "name": "Insignia",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Columna",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Nosotros · Minimarket y bodegón" },
        { "type": "range", "id": "font_size", "label": "Tamaño del texto", "unit": "px", "min": 10, "max": 20, "step": 1, "default": 13 },
        { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#ffffff" },
        { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#1a1a1a" },
        { "type": "color", "id": "dot_color", "label": "Color del punto", "default": "#ff4fd0" },
        { "type": "range", "id": "margin_bottom", "label": "Espacio inferior", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 20 }
      ]
    },
    {
      "type": "titulo",
      "name": "Título",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Columna",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "text", "label": "Título", "default": "El sabor de lo local," },
        { "type": "text", "id": "accent", "label": "Texto de acento (cursiva)", "default": "a tu puerta." },
        {
          "type": "select",
          "id": "heading_level",
          "label": "Nivel del encabezado",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2"
        },
        { "type": "font_picker", "id": "font", "label": "Fuente", "default": "assistant_n4" },
        { "type": "range", "id": "size_mobile", "label": "Tamaño en móvil", "unit": "px", "min": 28, "max": 72, "step": 2, "default": 44 },
        { "type": "range", "id": "size_desktop", "label": "Tamaño en escritorio", "unit": "px", "min": 36, "max": 120, "step": 2, "default": 72 },
        { "type": "color", "id": "color", "label": "Color del título", "default": "#1a1a1a" },
        { "type": "color", "id": "accent_color", "label": "Color del acento", "default": "#a3157c" },
        { "type": "range", "id": "margin_bottom", "label": "Espacio inferior", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 24 }
      ]
    },
    {
      "type": "texto",
      "name": "Texto",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Columna",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Productos frescos, artesanales y seleccionados con amor. Somos el único local con delivery en Tucacas, y queremos que cada compra se sienta como ir a la bodega de confianza."
        },
        { "type": "font_picker", "id": "font", "label": "Fuente", "default": "assistant_n4" },
        { "type": "range", "id": "size_mobile", "label": "Tamaño en móvil", "unit": "px", "min": 12, "max": 24, "step": 1, "default": 16 },
        { "type": "range", "id": "size_desktop", "label": "Tamaño en escritorio", "unit": "px", "min": 12, "max": 28, "step": 1, "default": 18 },
        { "type": "color", "id": "color", "label": "Color del texto", "default": "#5c5550" },
        { "type": "range", "id": "max_width", "label": "Ancho máximo del texto", "unit": "ch", "min": 30, "max": 90, "step": 2, "default": 52 },
        { "type": "range", "id": "margin_bottom", "label": "Espacio inferior", "unit": "px", "min": 0, "max": 80, "step": 4, "default": 28 }
      ]
    },
    {
      "type": "boton",
      "name": "Botón",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Columna",
