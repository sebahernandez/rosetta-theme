{% stylesheet %}
  .contact-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: var(--cc-pad);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius);
    background-color: var(--cc-bg);
  }

  .contact-card__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--cc-icon-bg);
    color: var(--cc-icon-color);
  }

  .contact-card__icon svg {
    display: block;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-card__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-card__title,
  .contact-card__value,
  .contact-card__desc {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .contact-card__title {
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--cc-title);
  }

  .contact-card__value {
    margin-top: 2px;
    font-size: 1.8rem;
    line-height: 1.4;
    color: var(--cc-value);
  }

  .contact-card__desc {
    margin-top: 14px;
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--cc-desc);
  }

  .contact-card__link {
    margin-top: auto;
    padding-top: 20px;
  }

  .contact-card__link a {
    display: inline-block;
    border-bottom: 1px solid currentColor;
    color: var(--cc-link);
    font-size: 1.6rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .contact-card__link a:focus-visible {
    outline: 2px solid var(--cc-link);
    outline-offset: 3px;
  }
{% endstylesheet %}

{%- liquid
  assign link_url = block.settings.link_url
  assign is_external = false
  if link_url contains '://'
    assign is_external = true
  endif
-%}

<article
  class="contact-card"
  style="
    --cc-bg: {{ block.settings.bg_color }};
    --cc-border: {{ block.settings.border_color }};
    --cc-icon-bg: {{ block.settings.icon_bg_color }};
    --cc-icon-color: {{ block.settings.icon_color }};
    --cc-title: {{ block.settings.title_color }};
    --cc-value: {{ block.settings.value_color }};
    --cc-desc: {{ block.settings.desc_color }};
    --cc-link: {{ block.settings.link_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.icon_image != blank or block.settings.icon != 'none' -%}
    <span class="contact-card__icon" aria-hidden="true">
      {%- if block.settings.icon_image != blank -%}
        {{ block.settings.icon_image | image_url: width: 108 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <svg viewBox="0 0 24 24" focusable="false">
          {%- case block.settings.icon -%}
            {%- when 'whatsapp' -%}
              <path d="M3 21l1.65-4.9A8.5 8.5 0 1 1 8 19.4L3 21z"></path>
              <path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2L9 8.5z"></path>
            {%- when 'mail' -%}
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="M3 7l9 6 9-6"></path>
            {%- when 'clock' -%}
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            {%- when 'phone' -%}
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path>
            {%- when 'pin' -%}
              <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            {%- when 'instagram' -%}
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M17.5 6.5h.01"></path>
            {%- when 'chat' -%}
              <path d="M4 5h16v11H9l-5 4V5z"></path>
          {%- endcase -%}
        </svg>
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if block.settings.title != blank -%}
    <h3 class="contact-card__title">{{ block.settings.title | escape }}</h3>
  {%- endif -%}
  {%- if block.settings.value != blank -%}
    <p class="contact-card__value">{{ block.settings.value | escape }}</p>
  {%- endif -%}
  {%- if block.settings.description != blank -%}
    <p class="contact-card__desc">{{ block.settings.description | escape }}</p>
  {%- endif -%}
  {%- if block.settings.link_text != blank and link_url != blank -%}
    <p class="contact-card__link">
      <a href="{{ link_url }}"{% if is_external %} target="_blank" rel="noopener"{% endif %}>
        {{- block.settings.link_text | escape -}}
      </a>
    </p>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Tarjeta de contacto",
  "settings": [
    { "type": "header", "content": "Ícono" },
    {
      "type": "select",
      "id": "icon",
      "label": "Ícono",
      "options": [
        { "value": "none", "label": "Sin ícono" },
        { "value": "whatsapp", "label": "WhatsApp" },
        { "value": "mail", "label": "Correo" },
        { "value": "clock", "label": "Reloj" },
        { "value": "phone", "label": "Teléfono" },
        { "value": "pin", "label": "Ubicación" },
        { "value": "instagram", "label": "Instagram" },
        { "value": "chat", "label": "Chat" }
      ],
      "default": "whatsapp"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Imagen de ícono propia",
      "info": "Si subes una imagen, reemplaza al ícono de la lista."
    },

    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "title", "label": "Título", "default": "WhatsApp" },
    { "type": "text", "id": "value", "label": "Valor principal", "default": "+58 412 000 0000" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "La vía más rápida para pedidos y pagos."
    },

    { "type": "header", "content": "Enlace" },
    { "type": "text", "id": "link_text", "label": "Texto del enlace", "default": "Abrir chat" },
    {
      "type": "url",
      "id": "link_url",
      "label": "Destino del enlace",
      "info": "Acepta https://wa.me/..., mailto: y tel:."
    },

    { "type": "header", "content": "Colores de la tarjeta" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Borde", "default": "#efe6dc" },
    { "type": "color", "id": "icon_bg_color", "label": "Fondo del ícono", "default": "#fbe3f4" },
    { "type": "color", "id": "icon_color", "label": "Color del ícono", "default": "#a3157c" },

    { "type": "header", "content": "Colores de los textos" },
    { "type": "color", "id": "title_color", "label": "Título", "default": "#1a1a1a" },
    { "type": "color", "id": "value_color", "label": "Valor principal", "default": "#1a1a1a" },
    { "type": "color", "id": "desc_color", "label": "Descripción", "default": "#5c5550" },
    { "type": "color", "id": "link_color", "label": "Enlace", "default": "#1a1a1a" }
  ],
  "presets": [
    {
      "name": "Tarjeta de contacto"
    }
  ]
}
{% endschema %}
